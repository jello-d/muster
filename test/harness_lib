# shellcheck shell=sh
# test/harness_lib - what every muster test shares: a scratch directory
# with the literal baked into its trap, an environment that is the test's
# own, real git fixtures, and the check counters.
#
# Sourced by a test/*.t AFTER it sets H_NAME (its name in the verdict).
# shellcheck disable=SC2034  # MUSTER, OUT, RC and friends are for the test

: "${H_NAME:?set H_NAME before sourcing harness_lib}"
HERE=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P) \
  || { echo "FAIL $H_NAME: cannot find test/"; exit 1; }
MUSTER=$HERE/../bin/muster
# The real file, for the few tests that copy or link the binary itself
# (how muster finds lib/ through a link): a wrapper there would test the
# wrapper. MUSTER may become one below; MUSTER_REAL never does.
MUSTER_REAL=$MUSTER

# --- scratch, with the literal baked into the trap ---------------------------
# The house rule: an rm -rf never runs on a deferred expansion. mktemp's
# answer is CHECKED, then written into the trap as a literal.
_T=$(mktemp -d "${TMPDIR:-/tmp}/muster-$H_NAME.XXXXXX") || _T=
case $_T in
  ''|*\'*) echo "FAIL $H_NAME: unusable scratch dir [$_T]"; exit 1 ;;
esac
[ -d "$_T" ] && [ "$_T" != "$PWD" ] && [ "$_T" != / ] \
  || { echo "FAIL $H_NAME: refusing [$_T] as scratch"; exit 1; }
# chmod first: the unreadable fixtures would otherwise survive the rm.
# shellcheck disable=SC2064  # EXPANDING NOW IS THE POINT: see above.
trap "chmod -R u+rwx '$_T' 2>/dev/null; rm -rf '$_T'" EXIT

# --- an environment that is the test's own -----------------------------------
# The user's global git config carries a hooksPath, and the user's HOME
# carries a real muster config; neither may leak into a fixture.
# NO INSTALLED MUSTER ON PATH. Once a box installs muster (tackup does),
# a test that consults PATH sees that copy, not this tree: setup.t's
# shadowing check reported the real install the day it arrived. Every
# directory holding a `muster` is dropped, so only this tree is in play.
_h_path=
_h_old=$IFS
IFS=:
for _h_d in $PATH; do
  [ -x "$_h_d/muster" ] || _h_path=${_h_path:+$_h_path:}$_h_d
done
IFS=$_h_old
PATH=$_h_path
export PATH

export HOME="$_T/home"
export GIT_CONFIG_GLOBAL="$_T/gitconfig" GIT_CONFIG_NOSYSTEM=1
# Every config declares what it manages (R12); the default declares both,
# which is what a test that writes no config of its own exercises.
export MUSTER_CONFIG="$_T/default-config" MUSTER_ROOT="$_T/src"
unset XDG_CONFIG_HOME GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
mkdir -p "$HOME" "$_T/src" "$_T/origins" "$_T/other"
printf 'manage repo\nmanage path\n' > "$MUSTER_CONFIG"
# h_cfg <file>: write a config from stdin, declaring both kinds (R12).
# APPENDED, which is legal anywhere in the file, so every line number a
# test asserts on is the one it wrote. A fresh line first, so content
# without a final newline is not glued to it (a blank line is legal).
h_cfg() { { cat; printf '\nmanage repo\nmanage path\n'; } > "$1"; }
cat > "$GIT_CONFIG_GLOBAL" <<'EOF'
[user]
  name = muster test
  email = test@example.invalid
[init]
  defaultBranch = main
[advice]
  detachedHead = false
EOF
ROOT=$_T/src

# MUSTER_SHELL=<shell>: run muster under THAT shell for the whole file,
# not the /bin/sh of its shebang. Every test calls "$MUSTER", so pointing
# it at a wrapper reaches all of them, unedited. test/run-shells sets it
# once per installed shell: ksh and zsh run the last part of a pipeline
# in the current shell, and a bug of exactly that shape hid in placement
# for days because only three files ran under more than one shell. The
# shell is resolved NOW, before any test narrows PATH.
if [ -n "${MUSTER_SHELL:-}" ]; then
  _h_sh=$(command -v "$MUSTER_SHELL" 2>/dev/null) || _h_sh=
  case $_h_sh in
    /*) ;;
    *) echo "FAIL $H_NAME: MUSTER_SHELL=$MUSTER_SHELL is not installed"
       exit 1 ;;
  esac
  case $_h_sh$MUSTER_REAL in
    *\'*) echo "FAIL $H_NAME: a quote in [$_h_sh] or [$MUSTER_REAL]"
         exit 1 ;;
  esac
  printf '#!/bin/sh\nexec %s %s "$@"\n' "'$_h_sh'" "'$MUSTER_REAL'" \
    > "$_T/muster-shell"
  chmod +x "$_T/muster-shell"
  MUSTER=$_T/muster-shell
fi

# CAN_LOCK: whether chmod 000 binds. As root it does not, and the
# unreadable-state checks are skipped rather than reported as failures.
mkdir -p "$_T/probe"
chmod 000 "$_T/probe"
if [ -r "$_T/probe" ]; then
  CAN_LOCK=''   # running as root: permissions do not bind, so skip these
else
  CAN_LOCK=1
fi
chmod 755 "$_T/probe"

# --- harness -----------------------------------------------------------------
N=0 FAILS=''
fail() { FAILS="$FAILS
  $1"; }
# assert <description> <command...>: one check, passes when command does
assert() {
  N=$((N + 1))
  _a_d=$1; shift
  "$@" || fail "$_a_d"
}
# survey [args...]: run it, porcelain, into OUT / ERR / RC
survey() {
  OUT=$("$MUSTER" survey --porcelain "$@" 2>"$_T/err" </dev/null)
  RC=$?
  ERR=$(cat "$_T/err")
}
rec() { printf '%s\n' "$OUT" | awk -v n="name=$1" '$1 == n'; }
field() { rec "$1" | tr ' ' '\n' | sed -n "s/^$2=//p"; }
# expect <name> <key> <want>: one check on one field of one record
expect() {
  N=$((N + 1))
  _x_got=$(field "$1" "$2")
  [ "$_x_got" = "$3" ] || fail "$1: $2=[$_x_got], want [$3] (rc=$RC)"
}
expect_rc() {   # <want> <context>
  N=$((N + 1))
  [ "$RC" = "$1" ] || fail "$2: exit $RC, want $1 (stderr: $ERR)"
}
has() { case $1 in *"$2"*) return 0 ;; esac; return 1; }
starts() { case $1 in "$2"*) return 0 ;; esac; return 1; }
lacks() { case $1 in *"$2"*) return 1 ;; esac; }
g() { _g_r=$1; shift; git -C "$_g_r" "$@" >/dev/null 2>&1; }

# mkrepo <name>: a clone of its own bare origin, one commit, tracking it.
mkrepo() {
  git init -q --bare "$_T/origins/$1.git"
  git clone -q "$_T/origins/$1.git" "$ROOT/$1" 2>/dev/null
  echo one > "$ROOT/$1/f"
  g "$ROOT/$1" add f
  g "$ROOT/$1" commit -m one
  g "$ROOT/$1" push -u origin main
}
# commit_file <repo> <file> <content> <message>: one commit, its parent
# directories made as needed.
commit_file() {
  mkdir -p "$(dirname -- "$1/$2")"
  printf '%s\n' "$3" > "$1/$2"
  g "$1" add -- "$2"
  g "$1" commit -m "$4"
}
head_of() { git -C "$1" rev-parse HEAD; }
# origin_head <name>: main on the bare origin mkrepo made for it.
origin_head() { git --git-dir="$_T/origins/$1.git" rev-parse main; }
# upstream_moves <name>: another clone pushes a commit; this one has not
# fetched it.
upstream_moves() {
  [ -d "$_T/other/$1" ] \
    || git clone -q "$_T/origins/$1.git" "$_T/other/$1" 2>/dev/null
  g "$_T/other/$1" pull
  echo "x$(date +%s)$N" >> "$_T/other/$1/f"
  g "$_T/other/$1" commit -am more
  g "$_T/other/$1" push
}

# h_stub_systemctl: a systemctl first on PATH that keeps enabled/active
# state in the scratch dir, so no test ever asks, let alone changes, the
# real user manager. The unit dir is proven to be inside scratch first.
h_stub_systemctl() {
  H_UNITS=$HOME/.config/systemd/user
  case $H_UNITS in
    "$_T"/*) ;;
    *) echo "FAIL $H_NAME: unit dir [$H_UNITS] is outside scratch"; exit 1 ;;
  esac
  H_SYS=$_T/systemd-state
  mkdir -p "$_T/stub" "$H_SYS"
  cat > "$_T/stub/systemctl" <<STUB
#!/bin/sh
printf '%s\n' "\$*" >> '$H_SYS/log'
[ "\$1" = --user ] || exit 9
shift
cmd=\$1; shift
[ "\${1:-}" = --now ] && shift
[ "\${1:-}" = --quiet ] && shift
case \$cmd in
  daemon-reload) exit 0 ;;
  enable) touch "$H_SYS/enabled.\$1" "$H_SYS/active.\$1" ;;
  disable) rm -f "$H_SYS/enabled.\$1" "$H_SYS/active.\$1" ;;
  is-enabled) [ -e "$H_SYS/enabled.\$1" ] ;;
  is-active) [ -e "$H_SYS/active.\$1" ] ;;
  # What a test PLANTS: list-timers prints timers.json, verbatim (none:
  # an empty list); show prints result.<unit> (none: success).
  list-timers) cat "$H_SYS/timers.json" 2>/dev/null || echo '[]' ;;
  show) for _a; do _u=\$_a; done
        cat "$H_SYS/result.\$_u" 2>/dev/null || echo success ;;
  *) exit 9 ;;
esac
STUB
  chmod +x "$_T/stub/systemctl"
  PATH="$_T/stub:$PATH"
  export PATH
}

# h_verdict: the last line of every test. A run that made no checks is
# not a pass: the count is DERIVED, and zero means the file stopped
# somewhere above without saying so.
h_verdict() {
  [ "$N" -gt 0 ] || fail "no checks ran"
  if [ -n "$FAILS" ]; then
    printf 'FAIL %s (%s checks)%s:%s\n' "$H_NAME" "$N" \
      "${MUSTER_SHELL:+ under $MUSTER_SHELL}" "$FAILS"
    exit 1
  fi
  printf 'ok   %s (%s checks)%s\n' "$H_NAME" "$N" \
    "${MUSTER_SHELL:+ under $MUSTER_SHELL}"
}
