# shellcheck shell=sh
# owed_lib - what each repo is owed to agree with its origin, and with the
# canonical copy of every vendored file it carries.
#
# Sourced by bin/muster after survey_lib, never executed. Read-only apart
# from the fetch, like the survey: it DIAGNOSES, and acting on the answer
# is a separate verb, so the diagnosis can be trusted to change nothing.
#
# WHY THIS SHAPE (shared-notes muster.md, "Prioritisation"): box A
# went red twice on 2026-09-30 from one structural cause, a canonical
# change fanned out on one box and never caught up on the other. Both
# times the remedy was per-repo catch-up, decided by this ladder, and
# reconciliation of a vendored file was needed zero times:
#
#   behind, clean                    -> pull       (ff-only)
#   diverged, files disjoint         -> rebase,push
#   diverged, files overlapping      -> escalate   (touch nothing)
#   dirty and behind                 -> skip       (never touch)
#   behind, and named by a `hold`    -> held       (never touch; not
#                                                   attention)
#   ahead only                       -> push
#   anything it could not establish  -> unknown    (state says why)
#
# EVERY VERDICT RESTS ON A FETCH, so owed fetches by default. --no-fetch
# keeps the refs as they are, and every record still carries the fetch
# time its verdict was computed from.
#
# THE RECORD, like the survey's, is one line of key=value, every key:
#
#   name owed state ahead behind fetched overlap artifacts path
#
# owed is a comma list (`nothing` when empty); state is the survey's;
# overlap is the first path both sides changed (escalate only); artifacts
# is `<relpath>:<verdict>` per vendored file the repo carries.

_ow_add() {   # <verdict>: append once
  case ,$OW_LIST, in
    *,"$1",*) ;;
    *) OW_LIST="${OW_LIST:+$OW_LIST,}$1" ;;
  esac
}

_ow_has() { case ,$SV_FLAGS, in *,"$1",*) return 0 ;; esac; return 1; }

# _ow_overlap <path>: the first path changed on BOTH sides since the merge
# base, printed; fails (prints nothing) when the sides are disjoint.
# Paths are git-quoted, so each is one line and both sides quote alike.
_ow_overlap() {
  _v_mb=$(_sv_git "$1" merge-base HEAD "$SV_UPREF") || { echo -; return; }
  {
    _sv_git "$1" -c core.quotePath=true diff --no-renames --name-only \
      "$_v_mb" HEAD | sed 's/^/L /'
    _sv_git "$1" -c core.quotePath=true diff --no-renames --name-only \
      "$_v_mb" "$SV_UPREF" | sed 's/^/R /'
  } | awk '
    { k = substr($0, 3) }
    $1 == "L" { l[k] = 1; next }
    k in l { print k; found = 1; exit }
    END { exit !found }'
}

# _ow_repo <path> <name>: the git half of the ladder, from the survey's
# globals.
_ow_repo() {
  # Declared and holding: nothing is owed. The state still shows.
  [ "$SV_STATE" != "$SV_EXPECT" ] || return 0
  # Terminal states may carry a suffix (absent,expect-mismatch), and the
  # mismatch is written onto the state rather than flagged, so both are
  # matched on the state string, not the flag list.
  case $SV_STATE in
    absent*|unreadable*|not-a-repo*|broken*|*expect-mismatch*)
      _ow_add unknown; return 0 ;;
  esac
  for _r_f in fetch-failed upstream-gone no-upstream detached unborn \
      count-failed status-failed; do
    if _ow_has "$_r_f"; then _ow_add unknown; return 0; fi
  done
  _ow_has deployed-differs && _ow_add redeploy
  # HELD: behind on purpose, so every verdict that would MOVE it (pull,
  # rebase, and skip, escalate, which exist only because it is behind)
  # is `held` instead, and no acting verb ever touches it. Not behind, it
  # is judged as any repo: unpushed work is still owed a push.
  if [ "$SV_BEHIND" -gt 0 ] && _sv_held "$2"; then _ow_add held; return 0; fi
  if [ "$SV_BEHIND" -gt 0 ] && _ow_has dirty; then _ow_add skip; return 0; fi
  if [ "$SV_BEHIND" -gt 0 ] && [ "$SV_AHEAD" -gt 0 ]; then
    _ow_diverged "$1"
  elif [ "$SV_BEHIND" -gt 0 ]; then
    _ow_add pull
  elif [ "$SV_AHEAD" -gt 0 ]; then
    _ow_add push
  fi
  # push_since: the committer time of the OLDEST unpushed commit, so the
  # push grace runs from the work that has waited longest. A rebase
  # resets it, as it should: the rebased commits are new.
  if [ "$SV_AHEAD" -gt 0 ] 2>/dev/null; then
    OW_PSINCE=$(_sv_git "$1" log --format=%ct "$SV_UPREF..HEAD" 2>/dev/null \
      | tail -n 1)
    [ -n "$OW_PSINCE" ] || OW_PSINCE=-
  fi
}

# _ow_diverged <path>: rebase only when it provably cannot touch local work:
# no file changed on both sides, and no local merge for a rebase to
# flatten. Anything else escalates, and escalate means touch nothing.
_ow_diverged() {
  if [ -n "$(_sv_git "$1" rev-list --merges "$SV_UPREF..HEAD")" ]; then
    OW_OVERLAP=-
    _ow_add escalate
    return 0
  fi
  if OW_OVERLAP=$(_ow_overlap "$1"); then
    _ow_add escalate
  else
    OW_OVERLAP=-
    _ow_add rebase
    _ow_add push
  fi
}

# _ow_canon_status <canonical>: `ok`, or why the canonical copy cannot be
# trusted. A canonical in a checkout that is behind, ahead, dirty or
# unfetchable is not the canonical: re-seeding from it on 2026-09-30 was
# avoided by a human checking, not by any tool.
_ow_canon_status() {
  [ -f "$1" ] && [ -r "$1" ] || { echo unreadable; return 0; }
  _c_top=$(git -C "$(dirname -- "$1")" rev-parse --show-toplevel \
    2>/dev/null) || { echo not-in-a-repo; return 0; }
  survey_judge canonical "$_c_top"
  case $SV_STATE in
    ok|dirty) ;;
    *) echo "$SV_STATE"; return 0 ;;
  esac
  if [ -n "$(_sv_git "$_c_top" status --porcelain -- "$1")" ]; then
    echo dirty
  else
    echo ok
  fi
}

# _ow_canon_load [name...]: every `artifact` line, with its canonical's
# status, whether an unknown copy should ROLL UP, and when the canonical
# last changed (its last commit, epoch, or -), into OW_ARTLIST as
# "<status> <roll:y|n> <changed> <canonical> <relpath>..." lines. Once
# per run.
#
# ONE PROBLEM, ONE ROW. A canonical whose checkout is behind (the normal
# state of a notes repo that moves all day) makes every copy of it
# unjudgeable, and rolling that up made 16 repos read `unknown` when the
# only thing owed was one pull, measured live 2026-10-01; scheduled, that
# is 17 alerts for one fact. When the canonical's repo is IN THE SET its
# own row already carries the problem (pull, push, skip), so the copies
# say `:unknown` and do not roll up. When nothing else would show it (the
# canonical is missing, outside any repo, or its repo is not in the
# set), they do.
_ow_canon_load() {
  OW_ARTLIST=
  [ -e "$SV_CONFIG" ] || return 0
  _l_set=$(SV_RECORD_FN=_sv_path_only survey_records "$@")
  while read -r _l_kw _l_canon _l_rels || [ -n "$_l_kw" ]; do
    [ "$_l_kw" = artifact ] || continue
    _l_canon=$(_sv_tilde "$_l_canon")
    _l_st=$(_ow_canon_status "$_l_canon")
    _l_roll=y
    if _l_top=$(git -C "$(dirname -- "$_l_canon")" rev-parse \
        --show-toplevel 2>/dev/null) \
      && printf '%s\n' "$_l_set" \
        | grep -qxF -- "$(_sv_esc "$(_sv_resolve "$_l_top")")"; then
      _l_roll=n
    fi
    [ "$_l_st" = ok ] || printf '%s %s %s\n' "muster: canonical" \
      "$_l_canon is $_l_st, so its copies are unknown rather than judged" \
      "against it" >&2
    _l_ct=$(GIT_OPTIONAL_LOCKS=0 git -C "$(dirname -- "$_l_canon")" log -1 \
      --format=%ct -- "$(basename -- "$_l_canon")" 2>/dev/null) || _l_ct=
    OW_ARTLIST="$OW_ARTLIST$_l_st $_l_roll ${_l_ct:--} $_l_canon $_l_rels
"
  done < "$SV_CONFIG"
}

# _ow_art_verdict <repo> <relpath> <canonical> <canonical-status>
_ow_art_verdict() {
  case ,$OW_LIST, in *,unknown,*) echo unknown; return 0 ;; esac
  [ "$4" = ok ] && [ -r "$1/$2" ] || { echo unknown; return 0; }
  if cmp -s -- "$1/$2" "$3"; then echo ok; return 0; fi
  if [ -n "$(_sv_git "$1" status --porcelain -- "$2")" ]; then
    echo skip; return 0
  fi
  [ -n "$SV_UPREF" ] || { echo unknown; return 0; }
  # The OPPOSITE REMEDIES (house notes): origin already carries the
  # canonical, so pulling fixes it and re-seeding would commit a change
  # the remote already has; or it does not, and a re-seed is owed.
  if _sv_git "$1" show "$SV_UPREF:$2" 2>/dev/null | cmp -s - "$3"; then
    echo pull
  else
    echo reseed
  fi
}

# _ow_optin <repo> <relpath...> [requires <relpath...>]: the first relpath
# the repo carries, printed; fails when it carries none, or carries one
# but none of the `requires` paths.
#
# REQUIRES EXISTS BECAUSE CARRYING A FILE IS NOT ALWAYS OPTING IN. A repo
# with a pre-commit hook of its OWN (shared-notes has one) carries a file at
# the vendored hook's path without ever having adopted it. tackup learned
# this first: there, the conventions TEST is the opt-in and the hook is
# judged only beside it. Faulting a repo for a convention it never adopted
# is how a check earns being ignored.
_ow_optin() {
  _i_repo=$1; shift
  _i_hit='' _i_req='' _i_mode=paths
  for _i_r in "$@"; do
    if [ "$_i_r" = requires ]; then _i_mode=req; _i_req=no; continue; fi
    [ -e "$_i_repo/$_i_r" ] || continue
    if [ "$_i_mode" = paths ]; then
      [ -n "$_i_hit" ] || _i_hit=$_i_r
    else
      _i_req=yes
    fi
  done
  [ -n "$_i_hit" ] && [ "$_i_req" != no ] || return 1
  printf '%s\n' "$_i_hit"
}

# _ow_artifacts <repo>: every vendored file it has opted into (above).
# A pull verdict does not roll up: the git half already says pull.
_ow_artifacts() {
  OW_ARTS='' OW_RSINCE=-
  while read -r _a_st _a_roll _a_ct _a_canon _a_rels; do
    [ -n "$_a_st" ] || continue
    # shellcheck disable=SC2086  # relpaths are words, split on purpose
    _a_rel=$(_ow_optin "$1" $_a_rels) || continue
    _a_v=$(_ow_art_verdict "$1" "$_a_rel" "$_a_canon" "$_a_st")
    OW_ARTS="${OW_ARTS:+$OW_ARTS,}$_a_rel:$_a_v"
    # reseed_since: when the canonical last changed, the oldest such time
    # over this repo's re-seeds, so the grace runs from the change that
    # has waited longest. A canonical changed TWICE with no re-seed
    # between counts from its second change: at most one grace late.
    if [ "$_a_v" = reseed ] && [ "$_a_ct" != - ] \
      && { [ "$OW_RSINCE" = - ] || [ "$_a_ct" -lt "$OW_RSINCE" ]; }; then
      OW_RSINCE=$_a_ct
    fi
    case $_a_v in
      reseed|skip) _ow_add "$_a_v" ;;
      unknown) [ "$_a_roll" = n ] || _ow_add unknown ;;
    esac
  done <<ARTS
$OW_ARTLIST
ARTS
  [ -n "$OW_ARTS" ] || OW_ARTS=-
}

# owed_record <name> <path> [<deployed-path>]: the survey's computation,
# then the ladder on top of it. One line, every key.
# owed_judge <name> <path> [<deployed>]: the verdicts into OW_LIST (and
# the SV_ facts), printing nothing; see survey_judge for why.
owed_judge() {
  survey_judge "$@"
  OW_LIST='' OW_OVERLAP=- OW_PSINCE=-
  _ow_repo "$2" "$1"
  _ow_artifacts "$2"
  [ -n "$OW_LIST" ] || OW_LIST=nothing
}

owed_record() {
  owed_judge "$@"
  printf 'name=%s owed=%s state=%s ahead=%s behind=%s fetched=%s' \
    "$(_sv_esc "$1")" "$OW_LIST" "$SV_STATE" "$SV_AHEAD" "$SV_BEHIND" \
    "$SV_FETCHED"
  printf ' overlap=%s artifacts=%s reseed_since=%s push_since=%s' \
    "$(_sv_esc "$OW_OVERLAP")" "$OW_ARTS" "$OW_RSINCE" "$OW_PSINCE"
  printf ' path=%s\n' "$(_sv_esc "$2")"
}

# A PENDING RE-SEED IS ONE TASK, not sixteen alerts (agreed with the user,
# 2026-10-05). A canonical change makes every vendored copy differ at
# once, on every box, until ONE box re-seeds and commits each repo and
# the others pull: measured, that was 16 rows on each of three boxes for
# every change, four changes in four days. So a row whose ONLY debt is a
# re-seed (and, in a catch-up record, that nothing was done to) folds
# into ONE `vendored-copies` item, and it is attention only once the
# canonical change is older than `reseed-grace` (default 60m): within it
# a sweep is normally under way, and the other boxes just pull. A repo
# owing a re-seed AND anything else stays its own row. Porcelain keeps
# every record. One rule, here, for both renderers.
#
# _ow_grace [<directive>]: a grace, in seconds, from `reseed-grace` (the
# default) or the directive named; 60m when the config says nothing.
_ow_grace() {
  _g_a=$(_sv_cfg_all "${1:-reseed-grace}" | head -n 1)
  if [ -n "$_g_a" ] && _g_s=$(_rn_seconds "$_g_a"); then printf '%s' "$_g_s"
  else printf '%s' 3600
  fi
}

# AN UNPUSHED COMMIT IS NOT AN ALARM WHILE IT IS FRESH (agreed with the
# user, 2026-10-05). Measured on one box over a week: 32 episodes of
# "owes a push", 27 of them settled within the hour by the session that
# made them, as commit-then-push does. So a `push` debt is attention only
# once its oldest unpushed commit is older than `push-grace` (default
# 60m). The row still shows, with how long; a repo owing anything else
# as well is judged by that too: a row is attention if ANY debt is due.
OW_RESEED_AWK='
function due(list, rsince, psince,  n, a, i) {
  n = split(list, a, ",")
  for (i = 1; i <= n; i++) {
    if (a[i] == "nothing" || a[i] == "held") continue
    if (a[i] == "reseed" && rsince ~ /^[0-9]+$/ && now - rsince < grace)
      continue
    if (a[i] == "push" && psince ~ /^[0-9]+$/ && now - psince < pgrace)
      continue
    return 1
  }
  return 0
}
function rs_take(list, since) {
  if (list != "reseed") return 0
  if (since ~ /^[0-9]+$/ && now - since < grace) {
    rs_young++; if (since + 0 > rs_new + 0) rs_new = since
  } else {
    rs_due++; if (rs_old == "" || since + 0 < rs_old + 0) rs_old = since
  }
  return 1
}
function rs_dur(s) {
  if (s < 120) return s "s"; if (s < 7200) return int(s / 60) "m"
  if (s < 172800) return int(s / 3600) "h"; return int(s / 86400) "d"
}
function rs_flagged() {
  if (rs_due) printf "name=vendored-copies owed=reseed remaining=reseed" \
    " result=- state=- count=%d reseed_since=%s\n", rs_due, rs_old
}
function rs_line(attn) {
  if (rs_due)
    printf "\nvendored-copies: %d repo(s) carry a copy that differs from" \
      " its canonical, changed %s ago (past the %s grace): re-seed them" \
      " from the canonical, one task on one box, then a commit per" \
      " repo\n", rs_due, rs_old ~ /^[0-9]+$/ ? rs_dur(now - rs_old) : "?",
      rs_dur(grace)
  if (rs_young && !attn)
    printf "\nvendored-copies: %d repo(s) await a re-seed of a canonical" \
      " changed %s ago; not attention until %s: a sweep is likely under" \
      " way\n", rs_young, rs_dur(now - rs_new), rs_dur(grace)
}'

# _ow_render <porcelain|table|attention>: records on stdin; exits 1 unless
# every repo is owed nothing, so the status is computed from the records
# shown. Over the 50-line guideline for the same reason as _sv_render: it is
# one awk program, and splitting it would split the renderer. attention: the
# table, only the rows that fail the run.
_ow_render() {
  awk -v mode="$1" -v now="$(date +%s)" -v grace="$(_ow_grace)" \
    -v pgrace="$(_ow_grace push-grace)" "$OW_RESEED_AWK"'
    function age(t, d) {
      if (t == "-" || t == "never") return t
      d = now - t
      if (d < 0) d = 0
      if (d < 120) return d "s"
      if (d < 7200) return int(d / 60) "m"
      if (d < 172800) return int(d / 3600) "h"
      return int(d / 86400) "d"
    }
    function add(w, s) { return w (w == "" ? "" : "; ") s }
    function why(  w, n, a, i) {
      # The state, minus ahead and behind: the counts below say those.
      w = ""
      n = split(f["state"], a, ",")
      for (i = 1; i <= n; i++)
        if (a[i] != "ok" && a[i] != "ahead" && a[i] != "behind")
          w = add(w, a[i])
      if (f["ahead"] + 0 > 0) w = add(w, "ahead " f["ahead"])
      if (f["behind"] + 0 > 0) w = add(w, "behind " f["behind"])
      if (f["push_since"] ~ /^[0-9]+$/)
        w = add(w, "unpushed " age(f["push_since"]))
      if (f["overlap"] != "-") w = add(w, "both changed " f["overlap"])
      n = split(f["artifacts"], a, ",")
      for (i = 1; i <= n; i++)
        if (a[i] != "-" && a[i] !~ /:ok$/) w = add(w, a[i])
      return w == "" ? "-" : w
    }
    {
      split("", f)
      for (i = 1; i <= NF; i++) {
        k = $i; sub(/=.*/, "", k)
        v = $i; sub(/^[^=]*=/, "", v)
        f[k] = v
      }
      if (!("owed" in f) || !("name" in f)) {
        print "muster: malformed record: " $0 > "/dev/stderr"
        bad = 1
        next
      }
      if (rs_take(f["owed"], f["reseed_since"])) {
        if (mode == "porcelain") print
        next
      }
      # held alone is not attention: being behind is the point of it;
      # a fresh push or re-seed waits out its grace (due(), above).
      rb = due(f["owed"], f["reseed_since"], f["push_since"])
      if (rb) bad = 1
      if (mode == "porcelain") { print; next }
      if (mode == "flagged") { if (rb) print; next }
      if (mode == "attention" && !rb) next
      n++
      nm[n] = f["name"]; ow[n] = f["owed"]; fe[n] = age(f["fetched"])
      wy[n] = why()
      if (length(nm[n]) > wn) wn = length(nm[n])
      if (length(ow[n]) > wo) wo = length(ow[n])
    }
    END {
      if ((mode == "table" || mode == "attention") && n > 0) {
        if (wn < 4) wn = 4
        if (wo < 4) wo = 4
        fmt = "%-" wn "s  %-" wo "s  %7s  %s\n"
        printf fmt, "REPO", "OWED", "FETCHED", "WHY"
        for (i = 1; i <= n; i++) printf fmt, nm[i], ow[i], fe[i], wy[i]
      }
      if (rs_due) bad = 1
      if (mode == "flagged") rs_flagged()
      if (mode == "table") rs_line(0)
      if (mode == "attention") rs_line(1)
      exit bad + 0
    }'
}

owed_main() {
  SV_MODE=table SV_DO_FETCH=1
  # shellcheck disable=SC2034  # SV_DO_FETCH is read by survey_lib
  while [ "$#" -gt 0 ]; do
    case $1 in
      --porcelain) SV_MODE=porcelain ;;
      --no-fetch) SV_DO_FETCH= ;;
      -h|--help) usage; return 0 ;;
      --) shift; break ;;
      -*) echo "muster owed: unknown option '$1'" >&2; return 2 ;;
      *) break ;;
    esac
    shift
  done
  survey_setup "$@" || return 2
  _ow_canon_load "$@"
  _m_out=$(SV_RECORD_FN=owed_record survey_records "$@") \
    || { echo "muster: owed itself failed" >&2; return 2; }
  [ -n "$_m_out" ] \
    || { echo "muster: no repos found under $SV_ROOT" >&2; return 2; }
  printf '%s\n' "$_m_out" | _ow_render "$SV_MODE"
}
