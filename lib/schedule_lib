# shellcheck shell=sh
# schedule_lib - systemd user timers for the declared profiles.
#
# Sourced by bin/muster, never executed. muster owns the MECHANISM, the
# integrator owns the facts (which profiles, how often), so the units are
# GENERATED from the profiles and never edited by hand: `install` makes
# the box match the profiles, `check` reports where it does not, `remove`
# takes every unit muster made back off. The verbs map onto an
# integrator's apply and check, which is the point.
#
# USER UNITS, deliberately: a muster run reads the user's own checkouts
# and nothing root touches, so by the house install-placement rule it
# runs as the user, from ~/.config/systemd/user.
#
# A UNIT IS OURS ONLY IF IT SAYS SO. Every generated file carries SC_MARK
# on its first line; `remove` and the orphan sweep touch nothing without
# it, so a hand-written muster-*.timer is never deleted.

SC_MARK='# generated by muster schedule: edit the profile, not this file'

_sc_dir() {
  printf '%s/systemd/user' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

_sc_ours() { [ -f "$1" ] && [ "$(head -n 1 -- "$1")" = "$SC_MARK" ]; }

# _sc_quote <value>: a value for a unit file, double-quoted. systemd
# expands % specifiers, so % is doubled; a value that could close the
# quote or escape it is refused rather than guessed at.
_sc_quote() {
  case $1 in
    *'"'*|*\\*|*"$SV_NL"*)
      echo "muster: cannot put [$1] in a unit file" >&2; return 1 ;;
  esac
  printf '"%s"' "$(printf '%s' "$1" | sed 's/%/%%/g')"
}

# _sc_service <profile>: the service unit, on stdout. The environment the
# run needs is BAKED IN at install, because a timer does not inherit the
# shell that installed it.
_sc_service() {
  _v_bin=$(_sc_quote "$MUSTER_BIN") || return 1
  _v_cfg=$(_sc_quote "MUSTER_CONFIG=$SV_CONFIG") || return 1
  printf '%s\n[Unit]\nDescription=muster run %s\n\n' "$SC_MARK" "$1"
  printf '[Service]\nType=oneshot\nExecStart=%s run %s\n' "$_v_bin" "$1"
  printf 'Environment=%s\n' "$_v_cfg"
  for _v_k in MUSTER_ROOT MUSTER_STATE_DIR MUSTER_NOTIFY MUSTER_KEEP; do
    eval "_v_v=\${$_v_k:-}"
    [ -n "$_v_v" ] || continue
    _v_q=$(_sc_quote "$_v_k=$_v_v") || return 1
    printf 'Environment=%s\n' "$_v_q"
  done
}

_sc_timer() {   # <profile> <interval>
  printf '%s\n[Unit]\nDescription=muster %s, every %s\n\n' \
    "$SC_MARK" "$1" "$2"
  printf '[Timer]\nOnStartupSec=5min\nOnUnitActiveSec=%s\n' "$2"
  printf '\n[Install]\nWantedBy=timers.target\n'
}

_sc_systemd() {   # fail loud where there is no systemd to schedule with
  command -v systemctl >/dev/null 2>&1 && return 0
  echo "muster: no systemctl here; run \`muster run <profile>\` from" \
    "this box's own scheduler instead" >&2
  return 1
}

# _sc_put <file> <content>: write only when it differs, and say which.
_sc_put() {
  if [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]; then
    printf 'unchanged  %s\n' "${1##*/}"
    return 0
  fi
  printf '%s\n' "$2" > "$1.tmp.$$" && mv -f "$1.tmp.$$" "$1" \
    && printf 'wrote      %s\n' "${1##*/}"
}

# _sc_orphans <profiles>: our units whose profile is no longer declared.
_sc_orphans() {
  for _o_f in "$(_sc_dir)"/muster-*.service "$(_sc_dir)"/muster-*.timer; do
    _sc_ours "$_o_f" || continue
    _o_n=${_o_f##*/muster-}
    _o_n=${_o_n%.*}
    printf '%s\n' "$1" | awk -v n="$_o_n" '$1 == n { f = 1 }
      END { exit !f }' || printf '%s\n' "$_o_f"
  done
}

_sc_install() {
  _sc_systemd || return 2
  _i_dir=$(_sc_dir)
  mkdir -p "$_i_dir" || return 2
  _i_list=$(run_profiles)
  _i_rc=0
  while read -r _i_n _i_v _i_e; do
    _i_s=$(_sc_service "$_i_n") || return 2
    _sc_put "$_i_dir/muster-$_i_n.service" "$_i_s" || _i_rc=1
    _sc_put "$_i_dir/muster-$_i_n.timer" "$(_sc_timer "$_i_n" "$_i_e")" \
      || _i_rc=1
  done <<PROFILES
$_i_list
PROFILES
  _i_orph=$(_sc_orphans "$_i_list")
  while IFS= read -r _i_f; do
    [ -n "$_i_f" ] || continue
    case $_i_f in
      *.timer) systemctl --user disable --now "${_i_f##*/}" \
        >/dev/null 2>&1 || : ;;
    esac
    rm -f -- "$_i_f" && printf 'removed    %s\n' "${_i_f##*/}"
  done <<ORPHANS
$_i_orph
ORPHANS
  systemctl --user daemon-reload || _i_rc=1
  while read -r _i_n _i_v _i_e; do
    systemctl --user enable --now "muster-$_i_n.timer" >/dev/null 2>&1 \
      || { echo "muster: could not enable muster-$_i_n.timer" >&2; _i_rc=1; }
  done <<PROFILES
$_i_list
PROFILES
  return "$_i_rc"
}

# _sc_check: read-only; one line per finding, exit 1 on any drift. What an
# integrator's check calls, so drift schedules its apply (install).
_sc_check() {
  _sc_systemd || return 2
  _k_dir=$(_sc_dir)
  _k_list=$(run_profiles)
  _k_bad=0
  while read -r _k_n _k_v _k_e; do
    for _k_u in service timer; do
      _k_f=$_k_dir/muster-$_k_n.$_k_u
      if [ "$_k_u" = service ]; then _k_want=$(_sc_service "$_k_n")
      else _k_want=$(_sc_timer "$_k_n" "$_k_e")
      fi || return 2
      if [ ! -f "$_k_f" ]; then
        printf 'missing    %s\n' "${_k_f##*/}"; _k_bad=1
      elif [ "$(cat "$_k_f")" != "$_k_want" ]; then
        printf 'differs    %s\n' "${_k_f##*/}"; _k_bad=1
      fi
    done
    systemctl --user is-enabled --quiet "muster-$_k_n.timer" 2>/dev/null \
      || { printf 'disabled   muster-%s.timer\n' "$_k_n"; _k_bad=1; }
    systemctl --user is-active --quiet "muster-$_k_n.timer" 2>/dev/null \
      || { printf 'inactive   muster-%s.timer\n' "$_k_n"; _k_bad=1; }
  done <<PROFILES
$_k_list
PROFILES
  _k_orph=$(_sc_orphans "$_k_list")
  while IFS= read -r _k_f; do
    [ -n "$_k_f" ] || continue
    printf 'orphan     %s\n' "${_k_f##*/}"; _k_bad=1
  done <<ORPHANS
$_k_orph
ORPHANS
  [ "$_k_bad" = 1 ] || echo "ok         every profile is scheduled as declared"
  return "$_k_bad"
}

_sc_remove() {
  _sc_systemd || return 2
  for _r_f in "$(_sc_dir)"/muster-*.timer "$(_sc_dir)"/muster-*.service; do
    _sc_ours "$_r_f" || continue
    case $_r_f in
      *.timer) systemctl --user disable --now "${_r_f##*/}" \
        >/dev/null 2>&1 || : ;;
    esac
    rm -f -- "$_r_f" && printf 'removed    %s\n' "${_r_f##*/}"
  done
  systemctl --user daemon-reload
}

schedule_main() {
  case ${1:-} in
    install|check|remove) ;;
    *) echo "usage: muster schedule install|check|remove" >&2; return 2 ;;
  esac
  [ "$#" = 1 ] || { echo "usage: muster schedule $1" >&2; return 2; }
  survey_config || return 2
  "_sc_$1"
}
