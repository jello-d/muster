# shellcheck shell=sh
# schedule_lib - systemd user timers for the declared profiles.
#
# Sourced by bin/muster, never executed. muster owns the MECHANISM, the
# integrator owns the facts (which profiles, how often), so the units are
# GENERATED from the profiles and never edited by hand: `install` makes
# the box match the profiles, `check` reports where it does not, `remove`
# takes every unit muster made back off. The verbs map onto an
# integrator's apply and check, which is the point.
#
# USER UNITS, deliberately: a muster run reads the user's own checkouts
# and nothing root touches, so by the house install-placement rule it
# runs as the user, from ~/.config/systemd/user.
#
# A UNIT IS OURS ONLY IF IT SAYS SO. Every generated file carries SC_MARK
# on its first line; `remove` and the orphan sweep touch nothing without
# it, so a hand-written muster-*.timer is never deleted.

SC_MARK='# generated by muster schedule: edit the profile, not this file'

_sc_dir() {
  printf '%s/systemd/user' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

_sc_ours() { [ -f "$1" ] && [ "$(head -n 1 -- "$1")" = "$SC_MARK" ]; }

# _sc_quote <value>: a value for a unit file, double-quoted. systemd
# expands % specifiers, so % is doubled; a value that could close the
# quote or escape it is refused rather than guessed at.
_sc_quote() {
  case $1 in
    *'"'*|*\\*|*"$SV_NL"*)
      echo "muster: cannot put [$1] in a unit file" >&2; return 1 ;;
  esac
  printf '"%s"' "$(printf '%s' "$1" | sed 's/%/%%/g')"
}

# _sc_service <profile>: the service unit, on stdout. The environment the
# run needs is BAKED IN at install, because a timer does not inherit the
# shell that installed it.
_sc_service() {
  _v_np=$(run_notify_problem)
  if [ -n "$_v_np" ]; then
    echo "muster: notify: $_v_np; refusing to bake it into a unit" >&2
    return 1
  fi
  _v_bin=$(_sc_quote "$MUSTER_BIN") || return 1
  _v_cfg=$(_sc_quote "MUSTER_CONFIG=$SV_CONFIG") || return 1
  printf '%s\n[Unit]\nDescription=muster run %s\n\n' "$SC_MARK" "$1"
  printf '[Service]\nType=oneshot\nExecStart=%s run %s\n' "$_v_bin" "$1"
  printf 'Environment=%s\n' "$_v_cfg"
  for _v_k in MUSTER_ROOT MUSTER_STATE_DIR MUSTER_NOTIFY MUSTER_KEEP; do
    if [ "$_v_k" = MUSTER_NOTIFY ]; then _v_v=$(run_notifier)
    else eval "_v_v=\${$_v_k:-}"
    fi
    [ -n "$_v_v" ] || continue
    # The notifier is baked as an ABSOLUTE path: a unit's PATH is not the
    # installing shell's, and a name that resolves here and not there is
    # how charon's faults once reached nobody. Unresolvable is refused.
    if [ "$_v_k" = MUSTER_NOTIFY ]; then
      _v_v=$(command -v "$_v_v" 2>/dev/null) || _v_v=
      case $_v_v in
        /*) ;;
        *) echo "muster: notifier '$(run_notifier)' does not resolve" \
             "to a command; refusing to bake it into a unit" >&2
           return 1 ;;
      esac
    fi
    _v_q=$(_sc_quote "$_v_k=$_v_v") || return 1
    printf 'Environment=%s\n' "$_v_q"
  done
}

_sc_timer() {   # <profile> <interval>
  printf '%s\n[Unit]\nDescription=muster %s, every %s\n\n' \
    "$SC_MARK" "$1" "$2"
  # OnActiveSec, not OnStartupSec: the first run comes two minutes after
  # the timer is ENABLED, whenever the user manager started, so a fresh
  # install produces evidence promptly instead of waiting a full interval.
  printf '[Timer]\nOnActiveSec=2min\nOnUnitActiveSec=%s\n' "$2"
  printf '\n[Install]\nWantedBy=timers.target\n'
}

_sc_systemd() {   # fail loud where there is no systemd to schedule with
  command -v systemctl >/dev/null 2>&1 && return 0
  echo "muster: no systemctl here; run \`muster run <profile>\` from" \
    "this box's own scheduler instead" >&2
  return 1
}

# _sc_put <file> <content>: write only when it differs, and say which.
_sc_put() {
  if [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]; then
    printf 'unchanged  %s\n' "${1##*/}"
    return 0
  fi
  printf '%s\n' "$2" > "$1.tmp.$$" && mv -f "$1.tmp.$$" "$1" \
    && printf 'wrote      %s\n' "${1##*/}"
}

# _sc_strays <profiles>: "<kind> <path>" for each of OUR units that intent
# does not want: `orphan` (its profile is no longer declared) or
# `unwanted` (declared, but driven by something other than systemd).
_sc_strays() {
  for _o_f in "$(_sc_dir)"/muster-*.service "$(_sc_dir)"/muster-*.timer; do
    _sc_ours "$_o_f" || continue
    _o_n=${_o_f##*/muster-}
    _o_n=${_o_n%.*}
    _o_d=$(printf '%s\n' "$1" | awk -v n="$_o_n" '$1 == n { print $4; exit }')
    case $_o_d in
      '') printf 'orphan %s\n' "$_o_f" ;;
      systemd) ;;
      *) printf 'unwanted %s\n' "$_o_f" ;;
    esac
  done
}

_sc_wanted() {   # <profiles>: the systemd-driven ones, same fields
  printf '%s\n' "$1" | awk '$4 == "systemd"'
}

# _sc_unstray <strays>: disable and delete units intent does not want.
_sc_unstray() {
  while read -r _u_k _u_f; do
    [ -n "$_u_f" ] || continue
    case $_u_f in
      *.timer) systemctl --user disable --now "${_u_f##*/}" \
        >/dev/null 2>&1 || : ;;
    esac
    rm -f -- "$_u_f" && printf 'removed    %s (%s)\n' "${_u_f##*/}" "$_u_k"
  done <<STRAYS
$1
STRAYS
}

# _sc_install: make the units match the INTENT. Only systemd-driven
# profiles get units; ours for any other profile, or for none, go.
_sc_install() {
  _i_list=$(run_profiles)
  # Never put a race on a timer: acting profiles that overlap are refused
  # here, before anything is written (muster check names them too).
  _i_ov=$(_rn_overlaps)
  if [ -n "$_i_ov" ]; then
    printf '%s\n%s\n' "muster: refusing to schedule overlapping acting" \
      "profiles (profile profile repo):" >&2
    printf '%s\n' "$_i_ov" >&2
    return 2
  fi
  _i_want=$(_sc_wanted "$_i_list")
  _i_stray=$(_sc_strays "$_i_list")
  if [ -z "$_i_want$_i_stray" ]; then
    echo "nothing to schedule: no profile is driven by systemd"
    return 0
  fi
  _sc_systemd || return 2
  _i_dir=$(_sc_dir)
  mkdir -p "$_i_dir" || return 2
  _i_rc=0
  while read -r _i_n _i_v _i_e _i_d _i_sel; do
    [ -n "$_i_n" ] || continue
    _i_s=$(_sc_service "$_i_n") || return 2
    _sc_put "$_i_dir/muster-$_i_n.service" "$_i_s" || _i_rc=1
    _sc_put "$_i_dir/muster-$_i_n.timer" "$(_sc_timer "$_i_n" "$_i_e")" \
      || _i_rc=1
  done <<PROFILES
$_i_want
PROFILES
  _sc_unstray "$_i_stray"
  systemctl --user daemon-reload || _i_rc=1
  while read -r _i_n _i_v _i_e _i_d _i_sel; do
    [ -n "$_i_n" ] || continue
    systemctl --user enable --now "muster-$_i_n.timer" >/dev/null 2>&1 \
      || { echo "muster: could not enable muster-$_i_n.timer" >&2; _i_rc=1; }
  done <<PROFILES
$_i_want
PROFILES
  return "$_i_rc"
}

# _sc_findings: "<kind> <unit>" for every way the units differ from the
# intent. All of it is DRIFT: `schedule install` repairs every line.
# Fails (2) only when systemd is wanted and is not here to ask.
_sc_findings() {
  _k_list=$(run_profiles)
  _k_want=$(_sc_wanted "$_k_list")
  if [ -n "$_k_want" ]; then _sc_systemd || return 2; fi
  _k_dir=$(_sc_dir)
  while read -r _k_n _k_v _k_e _k_d _k_sel; do
    [ -n "$_k_n" ] || continue
    for _k_u in service timer; do
      _k_f=$_k_dir/muster-$_k_n.$_k_u
      if [ "$_k_u" = service ]; then _k_w=$(_sc_service "$_k_n")
      else _k_w=$(_sc_timer "$_k_n" "$_k_e")
      fi || return 2
      if [ ! -f "$_k_f" ]; then printf 'missing    %s\n' "${_k_f##*/}"
      elif [ "$(cat "$_k_f")" != "$_k_w" ]; then
        printf 'differs    %s\n' "${_k_f##*/}"
      fi
    done
    systemctl --user is-enabled --quiet "muster-$_k_n.timer" 2>/dev/null \
      || printf 'disabled   muster-%s.timer\n' "$_k_n"
    systemctl --user is-active --quiet "muster-$_k_n.timer" 2>/dev/null \
      || printf 'inactive   muster-%s.timer\n' "$_k_n"
  done <<PROFILES
$_k_want
PROFILES
  _sc_strays "$_k_list" | while read -r _k_k _k_f; do
    printf '%-10s %s\n' "$_k_k" "${_k_f##*/}"
  done
}

# _sc_check: read-only; the findings, exit 1 on any. Every line is one
# `install` repairs, so an integrator's check maps exit 1 to its apply.
_sc_check() {
  _k_out=$(_sc_findings) || return 2
  if [ -n "$_k_out" ]; then printf '%s\n' "$_k_out"; return 1; fi
  echo "ok         the units match the declared intent"
}

_sc_remove() {
  _sc_systemd || return 2
  for _r_f in "$(_sc_dir)"/muster-*.timer "$(_sc_dir)"/muster-*.service; do
    _sc_ours "$_r_f" || continue
    case $_r_f in
      *.timer) systemctl --user disable --now "${_r_f##*/}" \
        >/dev/null 2>&1 || : ;;
    esac
    rm -f -- "$_r_f" && printf 'removed    %s\n' "${_r_f##*/}"
  done
  systemctl --user daemon-reload
}

schedule_main() {
  case ${1:-} in
    install|check|remove) ;;
    *) echo "usage: muster schedule install|check|remove" >&2; return 2 ;;
  esac
  [ "$#" = 1 ] || { echo "usage: muster schedule $1" >&2; return 2; }
  survey_config || return 2
  "_sc_$1"
}
