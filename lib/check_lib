# shellcheck shell=sh
# check_lib - `muster check`: is all well with muster on THIS box, judged
# against what was DECLARED rather than guessed?
#
# Sourced by bin/muster, never executed. Agreed 2026-10-01: a comprehensive
# check has to know the user's INTENT, because scheduling is optional. So
# the config declares who drives each profile (systemd, external, manual)
# and this squares that intent against what is actually here: the policy,
# the units, and whether the runs the intent promises are happening.
#
# Every finding is one of two kinds, because they want opposite remedies
# and a check that blurs them is the box A "APPLY DID NOT FIX" loop:
#
#   drift   `muster schedule install` repairs it (a unit missing,
#           different, disabled, or present against intent)       exit 1
#   fault   no apply repairs it; a human, or something outside muster,
#           must act (overlap, a missing repo, an incoherent profile,
#           a run that is stale, never happened, or failed)       exit 3
#
# A fault outranks drift in the exit. Notes (a pattern matching nothing
# here) are shown and never counted. Exit 2: the config is invalid, or the
# check could not run. NOT judged: whether repos need attention. That is
# the fleet's state, reported by `report` and the notifier, not muster's
# health.

_ck_add() {   # <fault|drift|note> <words of the line...>
  _a_k=$1; shift
  case $_a_k in
    fault) CK_FAULT="${CK_FAULT}fault  $*
" ;;
    drift) CK_DRIFT="${CK_DRIFT}drift  $*
" ;;
    note) CK_NOTE="${CK_NOTE}note   $*
" ;;
  esac
}

# _ck_literal_missing <name>: the literal is not a repo on this box.
_ck_literal_missing() {
  _l_path=$(_sv_cfg repo "$1") || _l_path=$SV_ROOT/$1
  case $(_sv_where "$_l_path") in
    repo) _sv_probe_git "$_l_path" 2>/dev/null && return 1 ;;
    unreadable) return 1 ;;   # it is there; whether it is a repo is unknown
  esac
  return 0
}

# _ck_profile <name> <verb> <interval> <driver> [<selector>...]: its table
# row; its selection and coherence findings.
_ck_profile() {
  _p_n=$1 _p_v=$2 _p_e=$3 _p_d=$4
  shift 4
  if [ "$_p_d" = manual ] && [ "$_p_e" != - ]; then
    _ck_add fault "interval   $_p_n: every $_p_e, but driven by nothing" \
      "(manual); declare a driver, or write -"
  elif [ "$_p_d" != manual ] && [ "$_p_e" = - ]; then
    _ck_add fault "interval   $_p_n: driven by $_p_d with no interval to" \
      "judge its runs against"
  fi
  if [ "$#" = 0 ]; then
    _p_names="all ($(SV_RECORD_FN=_rn_name_only survey_records \
      | grep -c . || :))"
  else
    for _p_s in "$@"; do
      case $_p_s in
        /*/) [ -n "$(_rn_expand "$_p_s")" ] \
               || _ck_add note "unmatched  $_p_n: $_p_s matches no repo here" ;;
        *) if _ck_literal_missing "$_p_s"; then
             _ck_add fault "missing    $_p_n: $_p_s is not a repo here"
           fi ;;
      esac
    done
    _p_names=$(_rn_expand "$@" | tr '\n' ' ' | sed 's/ $//')
    [ -n "$_p_names" ] \
      || _ck_add fault "empty      $_p_n: selects no repos on this box"
  fi
  printf '%-12s  %-8s  %-5s  %-8s  %s\n' "$_p_n" "$_p_v" "$_p_e" "$_p_d" \
    "${_p_names:-(none)}"
}

# _ck_runs <status-line>: a driven profile whose runs are not happening,
# or whose last run could not run, is a fault no install repairs.
_ck_runs() {
  # shellcheck disable=SC2046  # four space-free values, split
  set -- $(printf '%s\n' "$1" | awk '{
    for (i = 1; i <= NF; i++) {
      k = $i; sub(/=.*/, "", k); v = $i; sub(/^[^=]*=/, "", v); f[k] = v
    }
    print f["profile"], f["every"], f["driver"], f["status"] }')
  case $4 in
    stale) _ck_add fault "stale      $1: last run older than twice its" \
             "interval ($2); its $3 driver has stopped running it" ;;
    never) _ck_add fault "never      $1: driven by $3 every $2, and has" \
             "never run" ;;
    failed) _ck_add fault "failed     $1: its last run could not run" \
              "(see muster report)" ;;
  esac
}

check_main() {
  [ "$#" = 0 ] || { echo "usage: muster check" >&2; return 2; }
  survey_config || return 2
  CK_FAULT='' CK_DRIFT='' CK_NOTE=''
  printf '%-12s  %-8s  %-5s  %-8s  %s\n' PROFILE VERB EVERY DRIVER REPOS
  _c_list=$(run_profiles)
  while read -r _c_n _c_v _c_e _c_d _c_sel; do
    # shellcheck disable=SC2086  # selectors are words
    _ck_profile "$_c_n" "$_c_v" "$_c_e" "$_c_d" $_c_sel
    _ck_runs "$(_rn_status "$_c_n" "$_c_v" "$_c_e" "$_c_d")"
  done <<PROFILES
$_c_list
PROFILES
  _c_ov=$(_rn_overlaps)
  while read -r _c_a _c_b _c_r; do
    [ -z "$_c_r" ] \
      || _ck_add fault "overlap    $_c_a and $_c_b both act on $_c_r"
  done <<OVERLAPS
$_c_ov
OVERLAPS
  [ -z "$(_pl_roots)" ] || _ck_placement
  _c_np=$(run_notify_problem)
  [ -z "$_c_np" ] || _ck_add fault "notify     $_c_np"
  _ck_schedule
  if [ -z "$(_sv_cfg_all driver)" ]; then
    _ck_add note "driver     none declared, so profiles without driver=" \
      "are $RUN_DRIVER_DEFAULT (run on demand, never scheduled)"
  fi
  [ -z "$CK_FAULT$CK_DRIFT$CK_NOTE" ] \
    || printf '\n%s%s%s' "$CK_FAULT" "$CK_DRIFT" "$CK_NOTE"
  if [ -n "$CK_FAULT" ]; then return 3; fi
  if [ -n "$CK_DRIFT" ]; then return 1; fi
  return 0
}

# _ck_placement: config placed as copies (place_lib). What `muster place`
# repairs is drift (an integrator's apply runs place). What needs a person
# is a fault: every kept (displaced) edit until it is cleared, AND every
# pending merge-back. Merge-back is an EXPLICIT verb, never part of an
# apply (decided with the integrator, 2026-10-01: an apply that folded
# live edits into a shared working tree is the anti-pattern placement
# retires), so calling it drift would schedule an apply that can never
# clear it. Until it is merged back the edit is not in the source, and
# the other box will not get it: a person should know.
_ck_placement() {
  _g_recs=$(placement_records)
  while IFS= read -r _g_r; do
    [ -n "$_g_r" ] || continue
    _g_v=$(_st_field "$_g_r" verdict)
    _g_p=$(_st_unesc "$(_st_field "$_g_r" path)")
    case $_g_v in
      in-sync|app-held|unmanaged) ;;
      new|missing|place|converged|migrate|migrate-dir|displace|orphan)
        _ck_add drift "place      $_g_v $_g_p" ;;
      capture) _ck_add fault "capture    $_g_p: an application's work not" \
        "yet in the source; review it, then muster capture" ;;
      shadowed) _ck_add fault "place      shadowed $_g_p: a more specific" \
        "root owns this path; remove it from one of the two sources" ;;
      merge-back) _ck_add fault "merge-back $_g_p: a live edit not yet" \
        "in the source; review it, then muster merge-back" ;;
      *) _ck_add fault "place      $_g_v $_g_p" ;;
    esac
  done <<RECORDS
$_g_recs
RECORDS
  _g_disp=$(placement_displaced)
  while read -r _g_run _g_path; do
    [ -n "$_g_path" ] || continue
    _ck_add fault "displaced  $_g_path (run $_g_run): a repo-owned live" \
      "edit kept aside; review it, then muster displaced clear"
  done <<DISPLACED
$_g_disp
DISPLACED
}

# _ck_schedule: the units against the intent. Every line is drift, except
# that systemd being wanted and absent is a fault: no install can fix it.
_ck_schedule() {
  if [ -n "$(_sc_wanted "$(run_profiles)")" ] \
    && ! command -v systemctl >/dev/null 2>&1; then
    _ck_add fault "no-systemd profiles are driven by systemd, and there is" \
      "no systemctl here"
    return 0
  fi
  if _c_out=$(_sc_findings 2>&1); then
    while IFS= read -r _c_l; do
      [ -z "$_c_l" ] || _ck_add drift "$_c_l"
    done <<FINDINGS
$_c_out
FINDINGS
  else
    _ck_add fault "units      the expected units could not be computed:" \
      "$(printf '%s' "$_c_out" | head -n 1)"
  fi
}
