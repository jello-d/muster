# shellcheck shell=sh
# run_lib - named profiles, a store of every run, and one report over all
# of them.
#
# Sourced by bin/muster, never executed. Decided 2026-10-01 (shared-notes
# muster.md): muster owns periodic running and tackup declares it, the
# charon split again. Scheduled and manual runs take this ONE path, so the
# consolidated report reads one store and cannot disagree with either.
#
# A PROFILE is a POLICY OVER A SET OF REPOS: `profile <name> <verb>
# <interval> [<selector>...]`. Selectors narrow it from the whole set to
# some repos: a bare name, or /ERE/ matched against the whole name. With
# none declared there is one default, observe-only: `owed`, hourly, over
# everything. Which verb a profile runs is the integrator's choice, so a
# profile may run catch-up unattended, but nothing does unless declared.
#
# ACTING PROFILES MAY NOT OVERLAP. Two catch-up profiles selecting one repo
# could act on it at once; git's lock and the changed-underfoot check
# would catch that, but it is a race the config made possible, so `muster
# check` reports it and `run` and `schedule install` refuse it outright.
# Observe-only profiles overlap freely.
#
# THE STORE, per profile, under $MUSTER_STATE_DIR (default
# ~/.local/state/muster):
#
#   <profile>/latest.records   the verb's porcelain, exactly as printed
#   <profile>/latest.err       its stderr (fetch failures and the like)
#   <profile>/latest.meta      key=value: profile verb interval started
#                              finished exit host
#   <profile>/history/<started>-<pid>.{records,err,meta}, kept for
#                              the config's `keep` (default 7d);
#                              $MUSTER_KEEP, a count, overrides
#
# A RUN THAT CANNOT BE TRUSTED TO HAVE HAPPENED IS REPORTED AS SUCH: a
# profile with no latest run is `never`, and one older than twice its
# interval is `stale`. A timer that silently stopped firing is exactly the
# failure a scheduled checker exists to prevent, so its own absence has
# to be a finding.

# shellcheck disable=SC2034  # read by survey_lib's config check
RUN_VERBS='survey owed catch-up sync'
RUN_ACTING='catch-up sync'
# THE DRIVER WHEN NONE IS DECLARED: manual (agreed 2026-10-01), so a
# standalone muster is not nagged about timers nobody asked for, and
# nothing is scheduled that was not declared. It was systemd for one
# transition, expand then contract, because an integrator's config ran on
# timers with no driver line and this default would have removed them; it
# flipped once that config declared `driver systemd` on every box.
RUN_DRIVER_DEFAULT=manual

_rn_state_dir() {
  _d_base=${XDG_STATE_HOME:-$HOME/.local/state}/muster
  printf '%s' "${MUSTER_STATE_DIR:-$_d_base}"
}

_rn_seconds() {   # <interval> -> seconds; fails on anything else
  case $1 in
    ''|*[!0-9mhd]*) return 1 ;;
    *[0-9]m) printf '%s' $(( ${1%m} * 60 )) ;;
    *[0-9]h) printf '%s' $(( ${1%h} * 3600 )) ;;
    *[0-9]d) printf '%s' $(( ${1%d} * 86400 )) ;;
    *) return 1 ;;
  esac
}

# run_profiles: "<name> <verb> <interval> <driver> [<selector>...]" per
# declared profile, the DRIVER RESOLVED (a profile's driver= override,
# else the config's `driver` line, else RUN_DRIVER_DEFAULT) and the token
# taken out of the selectors. With no profile declared, muster's default:
# owed over everything, hourly when something drives it, on demand when
# nothing does.
run_profiles() {
  _f_glob=$(_sv_cfg_all driver | head -n 1)
  _f_glob=${_f_glob:-$RUN_DRIVER_DEFAULT}
  _f_out=
  if [ -e "$SV_CONFIG" ]; then
    # `if`, never `[ ] && printf`: a false AND-list as the loop's last
    # command makes the whole substitution fail under set -e, whenever
    # the config's LAST line is not a profile (found by the test suite).
    _f_out=$(while read -r _f_kw _f_a _f_b || [ -n "$_f_kw" ]; do
      if [ "$_f_kw" = profile ]; then
        printf '%s %s\n' "$_f_a" "$_f_b"
      fi
    done < "$SV_CONFIG" | awk -v g="$_f_glob" '{
      d = g; o = ""
      for (i = 4; i <= NF; i++) {
        if ($i ~ /^driver=/) { d = substr($i, 8); continue }
        o = o " " $i
      }
      print $1, $2, $3, d o
    }')
  fi
  if [ -n "$_f_out" ]; then printf '%s\n' "$_f_out"
  # The default is NAMED `default`, never after its verb: `profile owed
  # owed` made `muster owed` (the verb, ad hoc) and `muster run owed`
  # (the profile, which also stores and notifies) look like one command,
  # and reaching for one gets the work done with no banner update (the
  # integrator's finding, 2026-10-03, which renamed its own to `fleet`).
  elif [ "$_f_glob" = manual ]; then printf 'default owed - manual\n'
  else printf 'default owed 1h %s\n' "$_f_glob"
  fi
}

# _rn_profile <name> -> "<verb> <interval> <driver> [<selector>...]";
# fails if not declared.
_rn_profile() {
  run_profiles | awk -v n="$1" '$1 == n { sub(/^[^ ]+ /, ""); print
    f = 1; exit } END { exit !f }'
}

_rn_name_only() { printf '%s\n' "$1"; }

# _rn_expand [<selector>...]: the repo names a profile selects, one per
# line, in set order, each once. A literal is taken as given (like a name
# on the command line, so it may be absent: `muster check` says so); a
# /pattern/ is matched in full against the names in the set.
_rn_expand() {
  _x_set=$(SV_RECORD_FN=_rn_name_only survey_records)
  for _x_s in "$@"; do
    case $_x_s in
      /*/) _x_re=${_x_s#/}; _x_re=${_x_re%/}
           printf '%s\n' "$_x_set" | awk -v re="^($_x_re)\$" \
             'NF && $0 ~ re' ;;
      *) printf '%s\n' "$_x_s" ;;
    esac
  done | awk '!seen[$0]++'
}

_rn_acting() { case " $RUN_ACTING " in *" $1 "*) return 0 ;; esac; return 1; }

# _rn_overlaps: "<profile> <profile> <repo>" for every repo selected by two
# acting profiles. Expands every acting profile against THIS box's set.
_rn_overlaps() {
  run_profiles | while read -r _o_n _o_v _o_e _o_d _o_sel; do
    _rn_acting "$_o_v" || continue
    # shellcheck disable=SC2086  # selectors are words
    if [ -n "$_o_sel" ]; then _o_names=$(_rn_expand $_o_sel)
    else _o_names=$(SV_RECORD_FN=_rn_name_only survey_records)
    fi
    printf '%s\n' "$_o_names" | awk -v p="$_o_n" 'NF { print p, $0 }'
  done | awk '{ if ($2 in owner) print owner[$2], $1, $2
                else owner[$2] = $1 }'
}

# _rn_lock <dir>: one run per profile at a time. The pid is recorded so a
# lock left by a crashed run is taken over rather than blocking forever.
_rn_lock() {
  if mkdir "$1/lock" 2>/dev/null; then echo $$ > "$1/lock/pid"; return 0; fi
  _l_pid=$(cat "$1/lock/pid" 2>/dev/null) || _l_pid=
  if [ -n "$_l_pid" ] && kill -0 "$_l_pid" 2>/dev/null; then
    echo "muster: profile is already running (pid $_l_pid)" >&2
    return 1
  fi
  echo "muster: taking over a stale lock (pid ${_l_pid:-unknown})" >&2
  retro_event lock-taken-over "${1##*/}" "pid ${_l_pid:-unknown}"
  echo $$ > "$1/lock/pid"
}

_rn_unlock() { rm -f "$1/lock/pid"; rmdir "$1/lock" 2>/dev/null || :; }

# _rn_box_lock <dir>: ONE MUSTER RUN AT A TIME ON A BOX, waiting up to
# $MUSTER_RUN_WAIT seconds (default 600) for it. Found live: an hourly
# observing profile and a 15-minute catch-up profile, installed together,
# fired in the SAME SECOND; the catch-up pulled the canonical's repo while
# the observer was mid-run, so its copies were judged against one state
# and its row read another, and the report showed "unknown" with no row
# saying why. Runs take seconds, so waiting is cheap, and a mixed snapshot
# is not. Fails (1) when the wait runs out; a lock whose holder is dead
# is taken over. A holder that has not written its pid yet is waited for.
_rn_box_lock() {
  _b_wait=${MUSTER_RUN_WAIT:-600}
  _b_t=0
  while ! mkdir "$1" 2>/dev/null; do
    _b_pid=$(cat "$1/pid" 2>/dev/null) || _b_pid=
    if [ -n "$_b_pid" ] && ! kill -0 "$_b_pid" 2>/dev/null; then
      echo "muster: taking over a stale box lock (pid $_b_pid)" >&2
      retro_event lock-taken-over box "pid $_b_pid"
      break
    fi
    [ "$_b_t" -lt "$_b_wait" ] || return 1
    sleep 1
    _b_t=$((_b_t + 1))
  done
  echo $$ > "$1/pid"
}

# _rn_flagged <verb> <records-file>: "<name> <verdict>" for each row that
# fails the run, sorted. Only the verdict, never a timestamp, so two runs
# compare equal unless something actually CHANGED. The rows are chosen by
# the verb's own renderer: one definition of what needs attention.
#
# LESS ONE KIND OF ROW: `unknown` only because its fetch failed, while
# its last GOOD fetch is under RN_UNREACH_MAX old. That is a locked
# keyring at the greeter (measured by the integrator: every ssh origin,
# 8 repos named on the login banner), which logging in fixes and which
# nobody can act on before. The row still shows in every table and in
# report; it only stops raising the flag. Past the limit it counts
# again, so a key that STAYS broken is not hidden: "could not check for
# a day" is news. A row that never fetched at all always counts.
RN_UNREACH_MAX=86400
_rn_flagged() {
  case $1 in
    survey) _rn_r=_sv_render _rn_k='state' _rn_v=state ;;
    owed) _rn_r=_ow_render _rn_k='owed state' _rn_v=owed ;;
    catch-up|sync) _rn_r=_cu_render _rn_k='remaining result' \
      _rn_v=remaining ;;
  esac
  "$_rn_r" flagged < "$2" 2>/dev/null | awk -v keys="$_rn_k" \
    -v vk="$_rn_v" -v now="$(date +%s)" -v max="$RN_UNREACH_MAX" '{
    split("", f)
    for (i = 1; i <= NF; i++) {
      k = $i; sub(/=.*/, "", k); v = $i; sub(/^[^=]*=/, "", v); f[k] = v
    }
    if (f[vk] == "unknown" && ("," f["state"] ",") ~ /,fetch-failed,/ \
      && f["fetched"] ~ /^[0-9]+$/ && now - f["fetched"] < max) next
    n = split(keys, ks, " ")
    o = f["name"]
    for (i = 1; i <= n; i++) o = o " " f[ks[i]]
    print o
  }' | sort
}

# _rn_keep: how long a run's full records are kept, in seconds: the
# config's `keep <age>`, else 7 days.
_rn_keep() {
  _k_a=$(_sv_cfg_all keep | head -n 1)
  if [ -n "$_k_a" ] && _k_s=$(_rn_seconds "$_k_a"); then
    printf '%s' "$_k_s"
  else
    printf '%s' 604800
  fi
}

# _rn_store <dir> <started> <tmp-prefix>: move a finished run into place.
# history first, then latest by rename, so a reader of latest.* sees the
# old run or the new one, never half of each.
_rn_store() {
  mkdir -p "$1/history"
  for _s_x in records err meta; do
    cp "$3.$_s_x" "$1/history/$2.$_s_x"
  done
  for _s_x in records err meta; do
    mv -f "$3.$_s_x" "$1/latest.$_s_x"
  done
  # The heads belong to THIS run or to none: never a previous run's.
  if [ -f "$3.heads" ]; then mv -f "$3.heads" "$1/latest.heads"
  else rm -f "$1/latest.heads"
  fi
  # Prune. BY AGE, `keep <age>` in the config, 7 days by default: a
  # count meant different spans at different cadences (48 runs was two
  # days hourly and 12 hours at 15m, too short to see a week of a sync
  # profile, measured 2026-10-04). $MUSTER_KEEP, a COUNT, still
  # overrides, so whatever already set it keeps its meaning. Names lead
  # with the run's start in epoch seconds, so they sort by time.
  # shellcheck disable=SC2012  # names are digits and a fixed suffix
  ls "$1/history" | sed -n 's/\.meta$//p' | sort -n \
    | awk -v k="${MUSTER_KEEP:-}" -v cut="$(( $(date +%s) - $(_rn_keep) ))" \
      '{ a[NR] = $0 } END {
        for (i = 1; i <= NR; i++) {
          t = a[i]; sub(/-.*/, "", t)
          if (k != "" ? i <= NR - k : t + 0 < cut + 0) print a[i]
        } }' \
    | while read -r _s_old; do
        rm -f "$1/history/$_s_old.records" "$1/history/$_s_old.err" \
          "$1/history/$_s_old.meta"
      done
}

# _rn_notify <profile> <dir> <exit>: tell $MUSTER_NOTIFY the profile's
# STATE, in the fleet's notifier protocol (intervention-required's, which
# charon already speaks): `flag muster-<profile> "<message>"` while rows
# need attention or the run could not run, `clear muster-<profile>` when
# none do. State, not change: a flag is a standing fact that a login
# banner shows once, so raising it again is idempotent rather than noisy,
# and a notification that was lost corrects itself on the next run.
#
# CONFIGURED BUT ABSENT IS SAID, never a silent no-op: box A had a
# notifier baked into charon's units and missing from their PATH, and
# every fault reached nobody (charon-sync, notify()).
# run_notifier: the notifier, from $MUSTER_NOTIFY (what a unit bakes, or an
# override) else the config's `notify` line. Empty when neither is set.
#
# A CONFIG notifier must be an ABSOLUTE PATH (run_notify_problem). A bare
# name resolves through the PATH of whoever is asking, and the askers
# differ: a login shell has ~/bin, a timer, a cron job and a plain `ssh`
# do not. Found live by an integrator: check faulted on a healthy box
# because it ran without ~/bin. The environment override stays lenient,
# because whoever sets it resolves it in the context they are in.
run_notifier() {
  if [ -n "${MUSTER_NOTIFY:-}" ]; then printf '%s' "$MUSTER_NOTIFY"
  else _sv_cfg_all notify | head -n 1
  fi
}

# run_notify_problem: why the CONFIG's notifier cannot be trusted from
# every caller, or nothing. Says nothing when $MUSTER_NOTIFY overrides it.
run_notify_problem() {
  [ -z "${MUSTER_NOTIFY:-}" ] || return 0
  _np=$(_sv_cfg_all notify | head -n 1)
  case $_np in
    '') ;;
    /*) [ -x "$_np" ] || printf '%s is not an executable file' "$_np" ;;
    *) printf '%s %s' "'$_np' is a bare name, resolved through each" \
         "caller's PATH; declare its absolute path" ;;
  esac
}

_rn_notify() {
  _n_cmd=$(run_notifier)
  [ -n "$_n_cmd" ] || return 0
  if ! command -v "$_n_cmd" >/dev/null 2>&1; then
    echo "muster: notifier '$_n_cmd' is not on PATH; this run's state" \
      "will NOT reach it" >&2
    return 0
  fi
  _n_now=$(_rn_flagged "$RN_VERB" "$2/latest.records")
  _n_count=$(printf '%s' "$_n_now" | grep -c . || :)
  _n_names=$(printf '%s\n' "$_n_now" | awk 'NF { printf "%s%s",
    (n++ ? ", " : ""), $1 }')
  if [ "$3" -ge 2 ]; then
    set -- "$1" flag "muster $1 could not run (exit $3): muster report"
  elif [ "$_n_count" -gt 0 ]; then
    set -- "$1" flag "muster $1: $_n_count repo(s) need attention:" \
      "$_n_names"
  else
    set -- "$1" clear
  fi
  _n_p=$1; _n_verb=$2; shift 2
  "$_n_cmd" "$_n_verb" "muster-$_n_p" ${1+"$*"} \
    >/dev/null 2>&1 </dev/null \
    || { echo "muster: notifier $_n_cmd $_n_verb failed" >&2
         retro_event notifier-failed "$_n_cmd" "$_n_verb muster-$_n_p"; }
}

# _rn_invoke <profile>: the verb, over the profile's selection. A run that
# must not happen (an empty selection, an overlap) fails with exit 2 and a
# reason, and is STORED like any other, so report shows it as failed.
_rn_invoke() {
  _i_p=$1   # kept: `set --` below replaces the positional parameters
  if _rn_acting "$RN_VERB" \
    && _i_ov=$(_rn_overlaps | awk -v p="$1" '$1 == p || $2 == p') \
    && [ -n "$_i_ov" ]; then
    printf 'muster: refusing to run %s: another acting profile selects' "$1"
    printf ' the same repo(s):\n%s\n' "$_i_ov"
    return 2
  fi >&2
  # MUSTER_ORIGIN: the verb records its own actions in retro, as this
  # profile's. Set on an EXTERNAL command, so it cannot outlive the call.
  [ -n "$RN_SEL" ] || {
    MUSTER_ORIGIN=$1 "$MUSTER_BIN" "$RN_VERB" --porcelain; return; }
  # shellcheck disable=SC2086  # selectors are words
  _i_names=$(_rn_expand $RN_SEL)
  if [ -z "$_i_names" ]; then
    # NEVER fall back to the whole set: an empty selection that ran over
    # everything would be the quietest way to act where nobody asked.
    echo "muster: profile $1 selects no repos on this box ($RN_SEL)" >&2
    return 2
  fi
  _i_old=$IFS
  IFS='
'
  # shellcheck disable=SC2086  # one name per line, split on newline
  set -- $_i_names
  IFS=$_i_old
  MUSTER_ORIGIN=$_i_p "$MUSTER_BIN" "$RN_VERB" --porcelain -- "$@"
}

# CONFIG FAULTS REACH THE BANNER (agreed with the user, 2026-10-03). A
# pending merge-back, capture or displaced edit used to be seen only by
# `muster check`, so it could sit for days. Every run now stores the
# placement faults (placement_findings, the classification check uses,
# so the two never disagree) and flags `muster.config` with the notifier,
# a key no profile can take (profile names are [A-Za-z0-9_-]). report
# reads the store, so it stays instant.
#
#   no store      no placement declared on this box
#   empty store   checked, nothing needs a person
#   lines         one fault each, as check words it

_rn_config_store() { printf '%s/config.faults' "$(_rn_state_dir)"; }

# _rn_config_scan: under the box lock, so never mid-place. When placement
# cannot be read, the previous store is LEFT, never replaced by an empty
# one: "no faults" from a read that failed would be a silent all-clear.
_rn_config_scan() {
  _cs_f=$(_rn_config_store)
  if [ -z "$(_pl_roots)" ]; then rm -f "$_cs_f"; return 0; fi
  _cs_all=$(placement_findings 2>/dev/null) || return 0
  printf '%s\n' "$_cs_all" | sed -n 's/^fault //p' > "$_cs_f.$$" \
    && mv -f "$_cs_f.$$" "$_cs_f"
  rm -f "$_cs_f.$$"
}

# _rn_config_notify: the store's state, as a flag or a clear. A notifier
# that is configured and absent was already reported by _rn_notify.
_rn_config_notify() {
  _cn_cmd=$(run_notifier)
  [ -n "$_cn_cmd" ] && command -v "$_cn_cmd" >/dev/null 2>&1 || return 0
  _cn_f=$(_rn_config_store)
  if [ -s "$_cn_f" ]; then
    _cn_v=flag
    "$_cn_cmd" flag muster.config "muster: $(grep -c . "$_cn_f") config" \
      "fault(s) need a person; muster resolve lists each with its command" \
      >/dev/null 2>&1 </dev/null || _cn_v=failed
  else
    _cn_v=clear
    "$_cn_cmd" clear muster.config >/dev/null 2>&1 </dev/null \
      || _cn_v=failed
  fi
  [ "$_cn_v" != failed ] \
    || { echo "muster: notifier $_cn_cmd failed for muster.config" >&2
         retro_event notifier-failed "$_cn_cmd" muster.config; }
}

# _rn_report_config: report's config section, from the store.
_rn_report_config() {
  _rc_f=$(_rn_config_store)
  [ -s "$_rc_f" ] || return 0
  _rc_age=$(( $(date +%s) - $(_sv_mtime "$_rc_f" || date +%s) ))
  printf '\n== config needs a person (as of the last run, %s ago)\n' \
    "$(_rn_age "$_rc_age")"
  cat "$_rc_f"
  echo "each with its command: muster resolve"
}

# run_box_locked <verb> <cmd...>: run <cmd> holding the box lock, for a
# verb that ACTS outside `run` (resolve, push), so a timer cannot act on
# the same repos mid-way. One copy of the lock's arming and release, the
# literal baked into the trap when armed (the house rule on deferred
# expansion in a destructive trap). `run` itself keeps its own, which
# also stores a run that could not run. Exit: <cmd>'s, or 2 when the box
# could not be had.
run_box_locked() {
  _bx_verb=$1; shift
  _bx_box=$(_rn_state_dir)/.box-lock
  case $_bx_box in
    *\'*) echo "muster: unusable state dir [$_bx_box]" >&2; return 2 ;;
  esac
  mkdir -p "$(_rn_state_dir)" || return 2
  if ! _rn_box_lock "$_bx_box"; then
    echo "muster: another muster run held this box for" \
      "${MUSTER_RUN_WAIT:-600}s; $_bx_verb did not run" >&2
    return 2
  fi
  # shellcheck disable=SC2064  # expanding now is the point
  trap "rm -f '$_bx_box/pid'; rmdir '$_bx_box' 2>/dev/null" EXIT
  _bx_rc=0
  "$@" || _bx_rc=$?
  rm -f "$_bx_box/pid"
  rmdir "$_bx_box" 2>/dev/null || :
  trap - EXIT
  return "$_bx_rc"
}

# _rn_run_locked <profile> <dir> <tmp>: the verb, under the box lock,
# into <tmp>.records / .err; returns the verb's exit, or 2 when the box
# lock could not be had (stored as a run that did not run).
_rn_run_locked() {
  _q_box=$(_rn_state_dir)/.box-lock
  case $_q_box in
    *\'*) echo "muster: unusable state dir [$_q_box]" >&2; return 2 ;;
  esac
  if ! _rn_box_lock "$_q_box"; then
    : > "$3.records"
    printf '%s %s\n' "muster: another muster run held this box for" \
      "${MUSTER_RUN_WAIT:-600}s; this run did not run" > "$3.err"
    retro_run "$1" "$RN_VERB" "$3.records" "$3.err" 2
    return 2
  fi
  # Holding it now, so the cleanup may release it; armed only once held,
  # or an interrupted waiter would delete another run's lock.
  # shellcheck disable=SC2064  # expanding now is the point
  trap "rm -f '$3.records' '$3.err' '$3.meta' '$3.heads' '$2/lock/pid' \
    '$_q_box/pid'; rmdir '$2/lock' '$_q_box' 2>/dev/null" EXIT
  _q_rc=0
  _rn_invoke "$1" >"$3.records" 2>"$3.err" </dev/null || _q_rc=$?
  # Still holding the box: the refs as this run LEFT them.
  _rn_heads "$3.records" >"$3.heads" 2>/dev/null || :
  _rn_config_scan
  retro_run "$1" "$RN_VERB" "$3.records" "$3.err" "$_q_rc"
  # Released: disarm the box paths FIRST, so an interruption from here on
  # cannot remove a lock another run has taken in the meantime.
  # shellcheck disable=SC2064  # expanding now is the point
  trap "rm -f '$3.records' '$3.err' '$3.meta' '$3.heads' '$2/lock/pid'; \
    rmdir '$2/lock' 2>/dev/null" EXIT
  rm -f "$_q_box/pid"
  rmdir "$_q_box" 2>/dev/null || :
  return "$_q_rc"
}

# run_main <profile>: run it, store it, notify on change; exit as the verb.
run_main() {
  [ "$#" = 1 ] && [ -n "$1" ] \
    || { echo "usage: muster run <profile>" >&2; return 2; }
  survey_config || return 2
  _m_p=$(_rn_profile "$1") \
    || { echo "muster: no profile '$1' (see muster report)" >&2; return 2; }
  # shellcheck disable=SC2086  # verb, interval, driver, selectors: words
  set -- "$1" $_m_p
  RN_VERB=$2 RN_EVERY=$3 RN_DRIVER=$4
  _m_name=$1
  shift 4
  RN_SEL=$*
  set -- "$_m_name"
  case $1 in
    */*|.*) echo "muster: unusable profile name '$1'" >&2; return 2 ;;
  esac
  _m_dir=$(_rn_state_dir)/$1
  case $_m_dir in
    *\'*) echo "muster: unusable state dir [$_m_dir]" >&2; return 2 ;;
  esac
  mkdir -p "$_m_dir" || return 2
  _rn_lock "$_m_dir" || return 2
  _m_tmp=$_m_dir/.run.$$
  # An interrupted run must not leave its lock or temp files behind. The
  # paths are baked in NOW, as literals, per the house rule on deferred
  # expansion in a destructive trap (rm -f only, never -r).
  # shellcheck disable=SC2064  # expanding now is the point
  trap "rm -f '$_m_tmp.records' '$_m_tmp.err' '$_m_tmp.meta' '$_m_tmp.heads' \
    '$_m_dir/lock/pid'; rmdir '$_m_dir/lock' 2>/dev/null" EXIT
  _m_start=$(date +%s)
  _m_rc=0
  _rn_run_locked "$1" "$_m_dir" "$_m_tmp" || _m_rc=$?
  printf 'profile=%s\nverb=%s\ninterval=%s\ndriver=%s\n' \
    "$1" "$RN_VERB" "$RN_EVERY" "$RN_DRIVER" >"$_m_tmp.meta"
  printf 'started=%s\nfinished=%s\n' "$_m_start" "$(date +%s)" \
    >>"$_m_tmp.meta"
  printf 'exit=%s\nhost=%s\n' "$_m_rc" "$(hostname 2>/dev/null || echo -)" \
    >>"$_m_tmp.meta"
  _rn_store "$_m_dir" "$_m_start-$$" "$_m_tmp"
  _rn_notify "$1" "$_m_dir" "$_m_rc"
  _rn_config_notify
  _rn_unlock "$_m_dir"
  trap - EXIT
  return "$_m_rc"
}

_rn_age() {   # <seconds> -> 45s, 12m, 3h, 2d
  if [ "$1" -lt 120 ]; then printf '%ss' "$1"
  elif [ "$1" -lt 7200 ]; then printf '%sm' $(( $1 / 60 ))
  elif [ "$1" -lt 172800 ]; then printf '%sh' $(( $1 / 3600 ))
  else printf '%sd' $(( $1 / 86400 ))
  fi
}

_rn_meta() {   # <meta-file> <key> -> value, or -
  sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1 | grep . || echo -
}

# _rn_intent_since <name> <driver>: since when the intent to run on a
# schedule has stood: the timer unit's mtime (systemd), the config's
# (external). A run cannot be overdue before the intent is a full
# interval old, and a check run moments after an install must not call
# the run that has not happened yet a fault: that is the "APPLY DID NOT
# FIX" loop the house notes paid for on box A.
#
# Before the timer exists, the intent dates from the CONFIG that declared
# it: an integrator writes the config, then installs, then checks, and
# that sequence has to converge rather than read `never` in the gap.
_rn_intent_since() {
  case $2 in
    systemd) _sv_mtime "$(_sc_dir)/muster-$1.timer" \
               || _sv_mtime "$SV_CONFIG" ;;
    external) _sv_mtime "$SV_CONFIG" ;;
    *) return 1 ;;
  esac
}

# _rn_heads <records-file|->: "<escaped-path> <head> <upstream-head>" for
# each repo in a run's records, `-` where there is none. What `report`
# compares to say a run is out of date: HEAD and the upstream ref move on
# a pull, a push, a commit, a rebase or a fetch, which is every way the
# fleet's state changes. Uncommitted edits are left out on purpose: they
# would call every repo someone is working in "changed" all day. Two
# rev-parses a repo, so it stays instant (measured: ~0.1s for 23 repos,
# where a full stamp check took 1.8s).
_rn_heads() {
  awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^path=/) {
           sub(/^path=/, "", $i); print $i } }' "$1" \
    | while IFS= read -r _h_e; do
        _h_p=$(_st_unesc "$_h_e")
        _h_h=$(git -C "$_h_p" rev-parse -q --verify HEAD 2>/dev/null) \
          || _h_h=-
        _h_u=$(git -C "$_h_p" rev-parse -q --verify '@{upstream}' \
          2>/dev/null) || _h_u=-
        printf '%s %s %s\n' "$_h_e" "$_h_h" "$_h_u"
      done
}

# _rn_moved <heads-file>: the repos whose HEAD or upstream moved since,
# comma-joined (their directory names), or `-`.
_rn_moved() {
  [ -s "$1" ] || { printf -; return 0; }
  _v_now=$(_rn_heads_of "$1")
  printf '%s\n' "$_v_now" | awk 'NR == FNR { then[$1] = $2 " " $3; next }
    ($1 in then) && then[$1] != $2 " " $3 {
      n = $1; sub(/.*\//, "", n); o = o (o == "" ? "" : ",") n }
    END { print (o == "" ? "-" : o) }' "$1" -
}

# _rn_heads_of <heads-file>: the same repos' refs as they stand now.
# Piped, never a temp file: report is a read-only verb.
_rn_heads_of() {
  awk '{ printf "path=%s\n", $1 }' "$1" | _rn_heads -
}

# _rn_timer_alive <profile> <interval>: does SYSTEMD say it is still
# running this profile? Its timer's next firing is in the future and no
# more than one interval (plus a minute) away, AND the service's last
# result was success. Asked only when the wall clock says a run is
# overdue, because the two clocks differ across a SUSPEND: a timer counts
# awake time only, so after a night asleep every run looked "older than
# twice its interval" while the timers were healthy and due within the
# hour (measured by the integrator; this read as a fault most mornings).
# A timer that has stopped (no next firing, or one in the past: a hung
# run) is not alive, and nor is one firing a service that fails before
# muster can store anything (a missing binary): both stay loud. Any
# answer systemd cannot give (too old for JSON, no user manager) is "not
# alive", so the wall-clock verdict stands.
_rn_timer_alive() {
  _a_max=$(_rn_seconds "$2") || return 1
  command -v systemctl >/dev/null 2>&1 || return 1
  _a_next=$(systemctl --user list-timers --all --output=json \
    "muster-$1.timer" 2>/dev/null | awk -v u="\"unit\":\"muster-$1.timer\"" '
    BEGIN { RS = "}" }
    index($0, u) && match($0, /"next":[0-9]+/) {
      print substr($0, RSTART + 7, RLENGTH - 7); exit }')
  case $_a_next in ''|*[!0-9]*) return 1 ;; esac
  _a_left=$(( _a_next / 1000000 - $(date +%s) ))
  [ "$_a_left" -gt 0 ] && [ "$_a_left" -le $(( _a_max + 60 )) ] || return 1
  [ "$(systemctl --user show -p Result --value "muster-$1.service" \
    2>/dev/null)" = success ]
}

# _rn_status <name> <verb> <interval> <driver>: one porcelain line.
#   ok / attention / failed   the last run's exit: 0, 1, anything else
#   stale       driven, and the last run is older than twice the interval:
#               whatever should be running it has stopped
#   never       driven, no run yet, and the intent is older than twice
#               the interval: it has never been run when it should have
#   pending     driven, no run yet, intent younger than that
#   on-demand   manual, and never run: nothing expects it to have been
_rn_status() {
  _t_dir=$(_rn_state_dir)/$1
  _t_meta=$_t_dir/latest.meta
  _t_fin=$(_rn_meta "$_t_meta" finished)
  _t_exit=$(_rn_meta "$_t_meta" exit)
  _t_att=-
  _t_now=$(date +%s)
  _t_max=0
  [ "$4" = manual ] || _t_max=$(( $(_rn_seconds "$3" || echo 0) * 2 ))
  if [ "$_t_fin" = - ]; then
    if [ "$4" = manual ]; then _t_st=on-demand
    elif _t_since=$(_rn_intent_since "$1" "$4") \
      && [ $(( _t_now - _t_since )) -le "$_t_max" ]; then _t_st=pending
    elif [ "$4" = systemd ] && _rn_timer_alive "$1" "$3"; then
      _t_st=pending
    else _t_st=never
    fi
  else
    _t_att=$(_rn_flagged "$2" "$_t_dir/latest.records" | grep -c . || :)
    case $_t_exit in
      0) _t_st=ok ;;
      1) _t_st=attention ;;
      *) _t_st=failed ;;
    esac
    if [ "$4" != manual ] && [ $(( _t_now - _t_fin )) -gt "$_t_max" ] \
      && ! { [ "$4" = systemd ] && _rn_timer_alive "$1" "$3"; }; then
      _t_st=stale
    fi
  fi
  printf 'profile=%s verb=%s every=%s driver=%s status=%s finished=%s' \
    "$1" "$2" "$3" "$4" "$_t_st" "$_t_fin"
  _t_mv=-
  [ "$_t_fin" = - ] || _t_mv=$(_rn_moved "$_t_dir/latest.heads")
  printf ' exit=%s attention=%s host=%s moved=%s\n' "$_t_exit" "$_t_att" \
    "$(_rn_meta "$_t_meta" host)" "$_t_mv"
}

# report_main [--porcelain]: every profile's latest run, in one place.
# Exit 0 only when every profile's last run is fresh and clean.
report_main() {
  _r_mode=table
  case ${1:-} in
    --porcelain) _r_mode=porcelain; shift ;;
    -h|--help) usage; return 0 ;;
  esac
  [ "$#" = 0 ] || { echo "usage: muster report [--porcelain]" >&2; return 2; }
  survey_config || return 2
  _r_out=$(run_profiles | while read -r _r_n _r_v _r_e _r_d _r_sel; do
    _rn_status "$_r_n" "$_r_v" "$_r_e" "$_r_d"
  done)
  _r_cf=$(_rn_config_store)
  _r_nf=0
  [ ! -s "$_r_cf" ] || _r_nf=$(grep -c . "$_r_cf")
  if [ "$_r_mode" = porcelain ]; then
    printf '%s\n' "$_r_out"
    # One more record, only where placement is declared: not a profile.
    [ ! -e "$_r_cf" ] || printf 'config=placement faults=%s asof=%s\n' \
      "$_r_nf" "$(_sv_mtime "$_r_cf" || echo -)"
  else
    _rn_report_table "$_r_out"
    _rn_report_config
  fi
  [ "$_r_nf" = 0 ] || return 1
  # Fine: ok, and the two that are not overdue (pending, on-demand).
  printf '%s\n' "$_r_out" | awk '$5 !~ /^status=(ok|pending|on-demand)$/ {
    bad = 1 } END { exit bad + 0 }'
}

# _rn_report_table <status-lines>: the summary, then each profile's rows
# that need attention, drawn by that verb's own renderer.
_rn_report_table() {
  printf '%s\n' "$1" | awk -v now="$(date +%s)" '
    BEGIN { fmt = "%-12s  %-8s  %-5s  %-8s  %-6s  %-9s  %s\n"
            printf fmt, "PROFILE", "VERB", "EVERY", "DRIVER", "LAST",
              "STATUS", "ATTENTION" }
    {
      split("", f)
      for (i = 1; i <= NF; i++) {
        k = $i; sub(/=.*/, "", k); v = $i; sub(/^[^=]*=/, "", v); f[k] = v
      }
      last = "-"
      if (f["finished"] != "-") {
        d = now - f["finished"]
        last = d < 120 ? d "s" : d < 7200 ? int(d / 60) "m" : \
          d < 172800 ? int(d / 3600) "h" : int(d / 86400) "d"
      }
      printf fmt, f["profile"], f["verb"], f["every"], f["driver"], last,
        f["status"], f["attention"]
    }'
  printf '%s\n' "$1" | while read -r _p_l; do
    _p_n=$(printf '%s\n' "$_p_l" | tr ' ' '\n' | sed -n 's/^profile=//p')
    _p_v=$(printf '%s\n' "$_p_l" | tr ' ' '\n' | sed -n 's/^verb=//p')
    _p_rec=$(_rn_state_dir)/$_p_n/latest.records
    [ -s "$_p_rec" ] || continue
    _p_rows=$(_rn_render_attention "$_p_v" < "$_p_rec")
    [ -n "$_p_rows" ] || continue
    printf '\n== %s (%s)\n%s\n' "$_p_n" "$_p_v" "$_p_rows"
  done
  _rn_report_moved "$1"
}

# _rn_report_moved <status-lines>: the footer. A stored run is what the
# timer SAW; when its repos have moved since (a pull, a push, a fix made
# by hand), say which, and the command that makes the report current.
_rn_report_moved() {
  _m_lines=$(printf '%s\n' "$1" | awk '{
    for (i = 1; i <= NF; i++) {
      k = $i; sub(/=.*/, "", k); v = $i; sub(/^[^=]*=/, "", v); f[k] = v
    }
    if (f["moved"] != "" && f["moved"] != "-") {
      n = split(f["moved"], r, ",")
      m = r[1]; for (j = 2; j <= n; j++) m = m ", " r[j]
      printf "%s: %d repo(s) changed since its run (%s); refresh: " \
        "muster run %s\n", f["profile"], n, m, f["profile"]
    } }')
  [ -n "$_m_lines" ] || return 0
  printf '\n== changed since these runs\n%s\n' "$_m_lines"
  printf '%s\n' "or refresh them all and act on what is safe: muster resolve"
}

_rn_render_attention() {   # <verb>: records on stdin
  case $1 in
    survey) _sv_render attention ;;
    owed) _ow_render attention ;;
    catch-up|sync) _cu_render attention ;;
  esac || :
}
