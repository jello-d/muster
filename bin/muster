#!/bin/sh
# muster - keep many repos coherent enough to reason about.
#
# The entry point only dispatches. Each verb lives in a sourced lib, so a
# test can load one verb's functions without running the CLI.
set -eu

# C locale: git's messages are matched in English, and the discovery glob
# sorts the same way on every box.
LC_ALL=C
export LC_ALL

# FOLLOW SYMLINKS to find lib/, because an install links this file onto PATH
# and dirname of the LINK is the wrong directory.
_self=$0
while [ -h "$_self" ]; do
  _link=$(readlink -- "$_self")
  case $_link in
    /*) _self=$_link ;;
    *) _self=$(dirname -- "$_self")/$_link ;;
  esac
done
MUSTER_LIB=$(CDPATH='' cd -- "$(dirname -- "$_self")/../lib" && pwd -P) \
  || { echo "muster: no lib/ beside $_self" >&2; exit 2; }
[ -f "$MUSTER_LIB/survey_lib" ] \
  || { echo "muster: $MUSTER_LIB/survey_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/survey_lib
. "$MUSTER_LIB/survey_lib"
[ -f "$MUSTER_LIB/owed_lib" ] \
  || { echo "muster: $MUSTER_LIB/owed_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/owed_lib
. "$MUSTER_LIB/owed_lib"
[ -f "$MUSTER_LIB/catchup_lib" ] \
  || { echo "muster: $MUSTER_LIB/catchup_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/catchup_lib
. "$MUSTER_LIB/catchup_lib"
[ -f "$MUSTER_LIB/run_lib" ] \
  || { echo "muster: $MUSTER_LIB/run_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/run_lib
. "$MUSTER_LIB/run_lib"
[ -f "$MUSTER_LIB/schedule_lib" ] \
  || { echo "muster: $MUSTER_LIB/schedule_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/schedule_lib
. "$MUSTER_LIB/schedule_lib"
[ -f "$MUSTER_LIB/check_lib" ] \
  || { echo "muster: $MUSTER_LIB/check_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/check_lib
. "$MUSTER_LIB/check_lib"
[ -f "$MUSTER_LIB/stamp_lib" ] \
  || { echo "muster: $MUSTER_LIB/stamp_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/stamp_lib
. "$MUSTER_LIB/stamp_lib"
[ -f "$MUSTER_LIB/place_lib" ] \
  || { echo "muster: $MUSTER_LIB/place_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/place_lib
. "$MUSTER_LIB/place_lib"
[ -f "$MUSTER_LIB/push_lib" ] \
  || { echo "muster: $MUSTER_LIB/push_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/push_lib
. "$MUSTER_LIB/push_lib"
[ -f "$MUSTER_LIB/retro_lib" ] \
  || { echo "muster: $MUSTER_LIB/retro_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/retro_lib
. "$MUSTER_LIB/retro_lib"
[ -f "$MUSTER_LIB/resolve_lib" ] \
  || { echo "muster: $MUSTER_LIB/resolve_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/resolve_lib
. "$MUSTER_LIB/resolve_lib"
# The resolved path of this command, so a stored run re-enters it.
MUSTER_BIN=$(CDPATH='' cd -- "$(dirname -- "$_self")" && pwd -P)/${_self##*/}

usage() {
  cat <<'EOF'
usage: muster <command> [options]

A box declares what it manages, one kind a line in the config: `manage
repo` (the repo commands) and `manage path` (the placement commands). A
command of a kind not declared exits 2, and so does every command but
help when nothing is declared, or there is no config.

commands:
  survey [--porcelain] [--fetch] [name...]
         report the state of every repo in the set: dirty, ahead, behind
         as of the last fetch, no upstream, unreadable, and where a
         deployed clone is declared, whether it matches origin
  owed   [--porcelain] [--no-fetch] [name...]
         what each repo is owed to agree with origin and with the
         canonical copy of each vendored file: pull, rebase, push,
         escalate, skip, held, reseed, redeploy, or unknown. Fetches
         first; changes nothing else.
  (owed, sync and catch-up are ONE KNOB, how much muster may do about a
  repo that is behind: observe; fast-forward what nobody is using; also
  rebase when you ask. A profile picks the setting by naming the verb)
  catch-up [--dry-run] [--porcelain] [name...]
         act on owed's pull and rebase verdicts: fast-forward, or
         rebase when no file changed on both sides, each verified after.
         Touches nothing else, and never pushes.
  push   [--dry-run] [--all | name...]
         with no names, LISTS what would be pushed: each repo owed a
         push after a fresh fetch, its commits with their ages, and a
         dirty tree flagged. With --all or names, pushes exactly the
         commits it lists, fast-forward only, to the configured
         upstream: never --force, never tags, never another branch;
         each push verified, then every profile re-run. A repo ahead
         AND behind is refused (resolve first)
  sync   [--dry-run] [--porcelain] [name...]
         the UNATTENDED setting of the knob owed and catch-up are on:
         fast-forward only, and only a QUIESCENT repo: no git operation
         open, no process of yours inside (a shell parked at a prompt
         does not count), no tracked file saved since HEAD last moved.
         Never rebases. What it declines stays owed, and says why:
         busy, in-use, touched, unseen, diverged
  resolve [--dry-run] [--push] [name...]
         everything SAFE, in order: catch-up (the canonical first), place
         (box-wide, so not when repos are named), then every profile
         re-run so report is current. Then what NEEDS YOU, read fresh,
         each with its next command: push, escalate, dirty, unfetchable,
         merge-back, capture, conflict, displaced. Never pushes,
         unless --push, given every time: then push --all after the
         catch-up, and nothing else changes
  run    <profile>
         run a declared profile and store its records under
         ~/.local/state/muster/<profile>; what timers call. A profile's
         verb is survey, owed, sync, catch-up, or placed / place (every
         placed path)
  report [--porcelain]
         every profile's latest STORED run: age, status, and the rows
         that need attention. A run older than twice its interval is
         stale, and one that never happened says never. Instant, no
         network. A repo that moved since its run (a pull, a push, a
         commit made by hand) is named at the end, with the command that
         makes the report current: muster run <profile>, or resolve.
         Config faults (a pending merge-back, capture, displaced edit)
         as the last run stored them are listed too, and exit 1
  schedule install|check|remove
         systemd user timers for the profiles: install makes them match,
         check reports drift (exit 1), remove takes muster's units away
  check  is muster itself healthy on this box, judged against what was
         declared? The profiles (overlaps, repos missing here, empty
         selections), whether their runs are happening (stale, never,
         failed), the timers against each profile's driver, the
         notifier, and placed config: what place repairs is drift (exit
         1); what needs a person (merge-back, capture, conflict,
         displaced, a link it will not touch) is a fault (exit 3).
         Not whether repos need attention: that is report and resolve
  stamp  [--fetch] [name...]
         record the set as it stands (HEAD, the uncommitted tree, the
         upstream head) on stdout: take one before a long verification
  stamp check [--fetch] [--porcelain] <file|->
         does a stamp still describe the tree? holds, moved, changed,
         superseded (origin moved past it) or gone, per repo
  placed [--porcelain] [path...]
         config placed as copies: each managed file's verdict (in-sync,
         new, place, merge-back, displace, conflict, ...); read-only
  place  [--dry-run] [path...]
         place what is owed: new and changed source, migrations from
         symlinks, orphans; a repo-owned live edit is DISPLACED (kept,
         verified) first. Never touches a conflict or a merge-back
  merge-back [--dry-run] [path...]
         fold user-editable live edits into the source working tree;
         never commits, never writes a source file git reports modified
  capture [--dry-run] [path...]
         fold an application's new or changed files (under a `capture`
         directory) into the source working tree; never commits
  diff   [path...]
         what changed on EACH side of a placed file since it was last
         placed (last placed -> source, last placed -> live, and mode):
         every file not in sync, or those under the paths given, as
         destination or source. Read-only; the review before
         merge-back, capture, or deciding a conflict
  where  <path>
         which source a destination comes from, or the reverse
  retire [--dry-run] <layer-source|unrecorded>
         confirm that one layer, no longer declared, is meant to go:
         its files are removed (a repo-owned live edit displaced first,
         an edited user-editable file left as a conflict, an app-owned
         file only forgotten); nothing outside that layer is touched
  displaced [list | clear <run> <path>... | clear --all]
         the live edits kept aside by place; a check fault until cleared
  retro  <command>
         the LONG VIEW, for a periodic review: what was pulled, pushed
         and declined, what needed you and for how long, and the unusual
         events, kept for a rolling year. `muster retro help` lists its
         commands (show, events, tally, status, done)
  help   this text

exit: 0 every repo is ok (owed, catch-up: owes nothing after), 1
      something needs attention, 2 could not run; check adds 3, a fault
      that needs a person (and outranks 1)
EOF
}

# A verb of a kind this box does not manage stops here (R12), before its
# own config read, so the message is the same for every verb.
[ "$#" = 0 ] || sv_manage_gate "$1" || exit 2

case ${1:-} in
  survey) shift; survey_main "$@" ;;
  owed) shift; owed_main "$@" ;;
  catch-up) shift; catchup_main "$@" ;;
  sync) shift; sync_main "$@" ;;
  resolve) shift; resolve_main "$@" ;;
  push) shift; push_main "$@" ;;
  run) shift; run_main "$@" ;;
  report) shift; report_main "$@" ;;
  schedule) shift; schedule_main "$@" ;;
  check) shift; check_main "$@" ;;
  stamp) shift; stamp_main "$@" ;;
  placed) shift; placed_main "$@" ;;
  place) shift; place_main "$@" ;;
  merge-back) shift; merge_back_main "$@" ;;
  capture) shift; capture_main "$@" ;;
  diff) shift; diff_main "$@" ;;
  where) shift; where_main "$@" ;;
  retire) shift; retire_main "$@" ;;
  displaced) shift; displaced_main "$@" ;;
  retro) shift; retro_main "$@" ;;
  help|-h|--help) usage ;;
  '') usage >&2; exit 2 ;;
  *) echo "muster: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
