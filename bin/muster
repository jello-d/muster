#!/bin/sh
# muster - keep many repos coherent enough to reason about.
#
# The entry point only dispatches. Each verb lives in a sourced lib, so a
# test can load one verb's functions without running the CLI.
set -eu

# C locale: git's messages are matched in English, and the discovery glob
# sorts the same way on every box.
LC_ALL=C
export LC_ALL

# FOLLOW SYMLINKS to find lib/, because an install links this file onto PATH
# and dirname of the LINK is the wrong directory.
_self=$0
while [ -h "$_self" ]; do
  _link=$(readlink -- "$_self")
  case $_link in
    /*) _self=$_link ;;
    *) _self=$(dirname -- "$_self")/$_link ;;
  esac
done
MUSTER_LIB=$(CDPATH='' cd -- "$(dirname -- "$_self")/../lib" && pwd -P) \
  || { echo "muster: no lib/ beside $_self" >&2; exit 2; }
[ -f "$MUSTER_LIB/survey_lib" ] \
  || { echo "muster: $MUSTER_LIB/survey_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/survey_lib
. "$MUSTER_LIB/survey_lib"
[ -f "$MUSTER_LIB/owed_lib" ] \
  || { echo "muster: $MUSTER_LIB/owed_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/owed_lib
. "$MUSTER_LIB/owed_lib"
[ -f "$MUSTER_LIB/catchup_lib" ] \
  || { echo "muster: $MUSTER_LIB/catchup_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/catchup_lib
. "$MUSTER_LIB/catchup_lib"
[ -f "$MUSTER_LIB/run_lib" ] \
  || { echo "muster: $MUSTER_LIB/run_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/run_lib
. "$MUSTER_LIB/run_lib"
[ -f "$MUSTER_LIB/schedule_lib" ] \
  || { echo "muster: $MUSTER_LIB/schedule_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/schedule_lib
. "$MUSTER_LIB/schedule_lib"
[ -f "$MUSTER_LIB/check_lib" ] \
  || { echo "muster: $MUSTER_LIB/check_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/check_lib
. "$MUSTER_LIB/check_lib"
[ -f "$MUSTER_LIB/stamp_lib" ] \
  || { echo "muster: $MUSTER_LIB/stamp_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/stamp_lib
. "$MUSTER_LIB/stamp_lib"
[ -f "$MUSTER_LIB/place_lib" ] \
  || { echo "muster: $MUSTER_LIB/place_lib is missing" >&2; exit 2; }
# shellcheck source=SCRIPTDIR/../lib/place_lib
. "$MUSTER_LIB/place_lib"
# The resolved path of this command, so a stored run re-enters it.
MUSTER_BIN=$(CDPATH='' cd -- "$(dirname -- "$_self")" && pwd -P)/${_self##*/}

usage() {
  cat <<'EOF'
usage: muster <command> [options]

commands:
  survey [--porcelain] [--fetch] [name...]
         report the state of every repo in the set: dirty, ahead, behind
         as of the last fetch, no upstream, unreadable, and where a
         deployed clone is declared, whether it matches origin
  owed   [--porcelain] [--no-fetch] [name...]
         what each repo is owed to agree with origin and with the
         canonical copy of each vendored file: pull, rebase, push,
         escalate, skip, reseed, redeploy, or unknown. Fetches first;
         changes nothing else.
  catch-up [--dry-run] [--porcelain] [name...]
         act on owed's pull and rebase verdicts: fast-forward, or
         rebase when no file changed on both sides, each verified after.
         Touches nothing else, and never pushes.
  run    <profile>
         run a declared profile and store its records under
         ~/.local/state/muster/<profile>; what timers call
  report [--porcelain]
         every profile's latest stored run: age, status, and the rows
         that need attention. A run older than twice its interval is
         stale, and one that never happened says never
  schedule install|check|remove
         systemd user timers for the profiles: install makes them match,
         check reports drift (exit 1), remove takes muster's units away
  check  is the declared policy coherent on this box? expands every
         profile's selectors: overlapping acting profiles, literal names
         that are not repos here, profiles that select nothing
  stamp  [--fetch] [name...]
         record the set as it stands (HEAD, the uncommitted tree, the
         upstream head) on stdout: take one before a long verification
  stamp check [--fetch] [--porcelain] <file|->
         does a stamp still describe the tree? holds, moved, changed,
         superseded (origin moved past it) or gone, per repo
  placed [--porcelain] [path...]
         config placed as copies: each managed file's verdict (in-sync,
         new, place, merge-back, displace, conflict, ...); read-only
  place  [--dry-run] [path...]
         place what is owed: new and changed source, migrations from
         symlinks, orphans; a repo-owned live edit is DISPLACED (kept,
         verified) first. Never touches a conflict or a merge-back
  merge-back [--dry-run] [path...]
         fold user-editable live edits into the source working tree;
         never commits, never writes a source file git reports modified
  capture [--dry-run] [path...]
         fold an application's new or changed files (under a `capture`
         directory) into the source working tree; never commits
  where  <path>
         which source a destination comes from, or the reverse
  displaced [list | clear <run> <path>... | clear --all]
         the live edits kept aside by place; a check fault until cleared
  help   this text

exit: 0 every repo is ok (owed, catch-up: owes nothing after), 1
      something needs attention, 2 could not run
EOF
}

case ${1:-} in
  survey) shift; survey_main "$@" ;;
  owed) shift; owed_main "$@" ;;
  catch-up) shift; catchup_main "$@" ;;
  run) shift; run_main "$@" ;;
  report) shift; report_main "$@" ;;
  schedule) shift; schedule_main "$@" ;;
  check) shift; check_main "$@" ;;
  stamp) shift; stamp_main "$@" ;;
  placed) shift; placed_main "$@" ;;
  place) shift; place_main "$@" ;;
  merge-back) shift; merge_back_main "$@" ;;
  capture) shift; capture_main "$@" ;;
  where) shift; where_main "$@" ;;
  displaced) shift; displaced_main "$@" ;;
  help|-h|--help) usage ;;
  '') usage >&2; exit 2 ;;
  *) echo "muster: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
